[Unit]
Description=VIM4 KVM management dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=khadas
Group=khadas
# Port 80 without root; the KVM gateway's 8080 needs no capability.
# Switching goes through the sudoers-restricted helper,
# so NoNewPrivileges must stay off.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Restore the saved fan curve as root ("+"); a failure must not keep the
# dashboard from starting ("-").
ExecStartPre=-+/usr/libexec/vim4-manager-helper fan-restore
ExecStartPre=-+/usr/libexec/vim4-manager-helper storage-migrate
# Release downloads; the root helper installs from updates/ without following links.
StateDirectory=vim4-manager vim4-manager/updates
StateDirectoryMode=0700
ExecStart=/opt/vim4-manager/vim4-manager -listen :80
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
