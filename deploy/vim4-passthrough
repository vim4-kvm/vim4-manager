#!/usr/bin/env python3
"""Control an already qualified vendor VDIN/VFM tee without owning capture."""
import fcntl
import errno
from collections import deque
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import socket
import subprocess
from statistics import median
import sys
import tempfile
import time


TX = '/sys/class/amhdmitx/amhdmitx0/'
VIDEO = '/sys/class/video/'
RUNTIME = '/run/vim4-passthrough/'
QUALIFICATION = '/etc/vim4-kvm/passthrough-5.15.json'
OSD_BLANKS = tuple(f'/sys/class/drm/card0/osd{index}/blank' for index in (0, 1))
OSD_SAVED = RUNTIME + 'osd-before.json'


def atomic_json(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as output:
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def parse_fields(text):
    return {key.strip(): value.strip() for key, value in
            (line.split(':', 1) for line in text.splitlines() if ':' in line)}


def input_hdr(fields):
    if scalar(fields.get('Dolby Vision', '0')):
        return 'Dolby Vision'
    value = fields.get('HDR EOTF', 'SDR').upper().replace(' ', '_')
    if value in ('SDR', 'TRADITIONAL_SDR'):
        return 'SDR'
    if value in ('HDR10', 'SMPTE_ST_2048', 'SMPTE_ST_2084', 'PQ'):
        return 'HDR10'
    if value in ('HLG', 'BT_2100_HLG', 'HYBRID_LOG_GAMMA', 'BT_HLG'):
        return 'HLG'
    return 'Unknown HDR'


def display_modes(text):
    modes = {}
    for line in text.splitlines():
        match = re.fullmatch(r'(?:1920x|3840x)?(720|1080|2160)p(24|25|30|50|60)hz\*?', line.strip())
        if match:
            height, rate = map(int, match.groups())
            modes[(height, rate)] = f'{height}p{rate}hz'
    return modes


def canonical_mode(value):
    match = re.fullmatch(r'(?:1920x|3840x)?((?:720|1080|2160)p(?:24|25|30|50|60)hz)\*?', value.strip().lower())
    return match[1] if match else None


def scalar(value):
    match = re.search(r'(0x[0-9a-f]+|[0-9]+)\s*$', value.strip(), re.I)
    return int(match[1], 16 if match[1].lower().startswith('0x') else 10) if match else None


def canonical_color(value):
    match = re.match(r'\s*(rgb|444|422|420)\s*,\s*(8|10|12)\s*bit\b', value, re.I)
    return (match[1].lower(), int(match[2])) if match else None


def select_mode(input_state, modes, preferred=None):
    rate, fractional = min(((60, False), (60, True), (50, False), (30, False),
                            (30, True), (25, False), (24, False), (24, True)),
                           key=lambda item: abs(input_state['refreshHz'] - item[0] / (1.001 if item[1] else 1)))
    if preferred and preferred[0] == rate and rate in (24, 30, 60):
        midpoint = (rate + rate / 1.001) / 2
        if abs(input_state['refreshHz'] - midpoint) <= .005:
            fractional = preferred[1]
    hz = rate / (1.001 if fractional else 1)
    if abs(input_state['refreshHz'] - hz) > 0.2:
        raise ValueError('输入刷新率尚未验证，保持黑屏')
    candidates = [height for height, frequency in modes if frequency == rate and height <= input_state['height']]
    if not candidates:
        raise ValueError('显示器没有与输入刷新率匹配的已验证模式')
    height = max(candidates)
    return modes[(height, rate)], {720: 1280, 1080: 1920, 2160: 3840}[height], height, fractional


class VendorPassthrough:
    def __init__(self, root=Path('/'), release=None, run=subprocess.run):
        self.root = root
        self.release = platform.release() if release is None else release
        self.run = run
        self.blanked = None
        self.last_frame = None
        self.last_progress = None
        self.mode_key = None
        self.pending_key = None
        self.pending_since = None
        self.rate_choice = None
        self.rate_samples = deque(maxlen=7)
        self.rate_geometry = None
        self.monitor_identity = None
        self.readback_bad_since = None
        self.last_mismatch = None
        self.last_hpd = None
        self.connected_identity = None
        self.reconnecting = False
        self.sink_changed_at = None
        self.capture_ready = False
        self.last_error = None

    def path(self, name):
        return self.root / name.lstrip('/')

    def read(self, name):
        return self.path(name).read_text().strip()

    def write(self, name, value):
        self.path(name).write_text(str(value) + '\n')

    def update(self, name, value):
        if self.read(name).split() != str(value).split():
            self.write(name, value)

    def load(self, name, default=None):
        try:
            return json.loads(self.read(name))
        except FileNotFoundError:
            return default

    def qualified(self):
        if not self.release.startswith('5.15.'):
            return False
        proof = self.path(QUALIFICATION)
        try:
            info = proof.lstat()
            if info.st_uid != 0 or info.st_mode & 0o022 or proof.is_symlink() or not proof.is_file():
                return False
            qualified = self.load(QUALIFICATION)
            note = self.path('/sys/module/aml_media/notes/.note.gnu.build-id').read_bytes()
            if qualified.get('abi') != 1:
                return False
            # Keep rollback kernels qualified without accepting a release alone.
            builds = qualified.get('kernels', [qualified])
            digest = hashlib.sha256(note).hexdigest()
            return isinstance(builds, list) and any(
                isinstance(build, dict) and build.get('release') == self.release
                and build.get('moduleNoteSha256') == digest for build in builds)
        except (OSError, ValueError, TypeError, AttributeError):
            return False

    def supported(self):
        if not self.qualified():
            return False
        try:
            route = self.read('/sys/class/vfm/map')
            if not re.search(r'tvpath\s*\{\s*vdin0(?:\(\d+\))?\s+vfm_cap(?:\(\d+\))?\s+amvideo\s*\}', route):
                return False
            return all(self.path(name).is_file() for name in (*OSD_BLANKS,
                VIDEO + 'disable_video', VIDEO + 'axis', TX + 'disp_mode',
                TX + 'test_attr', TX + 'hpd_state', '/sys/class/display/mode'))
        except (OSError, ValueError, TypeError, AttributeError):
            return False

    def prepare(self):
        if not self.qualified():
            raise ValueError('未验证的运行模块，保留独立 KVM 采集')
        self.write('/sys/class/vfm/map', 'rm tvpath')
        self.write('/sys/class/vfm/map', 'add tvpath vdin0 vfm_cap amvideo')
        self.update(VIDEO + 'disable_video', 1)
        self.blank(self.load(RUNTIME + 'request.json', {'enabled': False})['enabled'])

    def input(self):
        captures = [path for path in self.path('/sys/class/video4linux').glob('video*')
                    if (path / 'name').read_text().strip() == 'vfm_cap']
        if len(captures) != 1:
            raise ValueError('无法唯一识别 VFM 采集端点')
        capture = parse_fields((captures[0] / 'status').read_text())
        self.capture_ready = capture.get('fmt_valid') == '1'
        if any(capture.get(key) != value for key, value in
               (('vfm_started', '1'), ('sm_state', '5'), ('draining', '0'))):
            return None
        fields = parse_fields(self.read('/sys/class/hdmirx/hdmirx0/info'))
        width, height = int(fields.get('Hactive', 0)), int(fields.get('Vactive', 0))
        rate = int(fields.get('Frame Rate', 0)) / 100
        if width <= 0 or height <= 0 or rate <= 0:
            return None
        if fields.get('Interlace') != '0':
            raise ValueError('隔行输入尚未验证')
        return {'width': width, 'height': height, 'refreshHz': rate,
                'colorFormat': fields.get('Color Space', '').partition('-')[2],
                'hdr': input_hdr(fields),
                'audio': int(fields.get('audio receive data', 0)) != 0}

    def monitor(self):
        try:
            return self.read_monitor()
        except (OSError, ValueError):
            self.reconnecting = True
            self.connected_identity = None
            self.mode_key = self.pending_key = None
            raise

    def read_monitor(self):
        if self.read(TX + 'hpd_state') != '1':
            self.monitor_identity = None
            return None
        modes = display_modes(self.read(TX + 'disp_cap'))
        if not modes:
            raise ValueError('显示器没有已验证的逐行模式')
        height, rate = max(modes, key=lambda item: (item[0], item[1]))
        name = 'HDMI'
        edid = bytes.fromhex(self.read(TX + 'rawedid'))
        if (len(edid) < 128 or edid[:8] != bytes.fromhex('00ffffffffffff00')
                or len(edid) < (edid[126] + 1) * 128
                or any(sum(edid[offset:offset + 128]) % 256 for offset in range(0, (edid[126] + 1) * 128, 128))):
            raise ValueError('显示器 EDID 无效')
        for offset in range(54, 126, 18):
            descriptor = edid[offset:offset + 18]
            if descriptor[:5] == b'\0\0\0\xfc\0':
                name = descriptor[5:18].decode('ascii', errors='replace').strip()
        self.monitor_identity = hashlib.sha256(edid).hexdigest()
        return {'name': name, 'maxWidth': {720: 1280, 1080: 1920, 2160: 3840}[height],
                'maxHeight': height, 'maxRefreshHz': rate,
                'hdr': bool(re.search(r'(SMPTE ST 2084|Hybrid Log-Gamma):\s*1', self.read(TX + 'hdr_cap'))),
                'audio': 'PCM,' in self.read(TX + 'aud_cap')}

    def snapshot(self, enabled):
        state = {'supported': True, 'enabled': enabled, 'audio': False, 'state': 'off'}
        input_state, monitor = self.input(), self.monitor()
        if input_state:
            state['input'] = input_state
        if monitor:
            state['monitor'] = monitor
        if enabled:
            state['state'] = 'no-monitor' if not monitor else 'no-signal' if not input_state else 'starting'
        return state

    def blank(self, blank):
        self.path(RUNTIME).mkdir(mode=0o700, parents=True, exist_ok=True)
        with self.path(RUNTIME + 'osd.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            self.apply_blank(blank)

    def apply_blank(self, blank):
        saved = self.load(OSD_SAVED)
        if blank and saved is None:
            saved = {name: scalar(self.read(name)) for name in OSD_BLANKS}
            if any(value not in (0, 1) for value in saved.values()):
                raise ValueError('无法读取持久 OSD blank 状态')
            atomic_json(self.path(OSD_SAVED), saved)
        if saved is not None:
            if set(saved) != set(OSD_BLANKS) or any(type(value) is not int or value not in (0, 1) for value in saved.values()):
                raise ValueError('OSD 恢复状态无效')
            for name in OSD_BLANKS:
                target = 1 if blank else saved[name]
                current = scalar(self.read(name))
                if current not in (0, 1):
                    raise ValueError('无法读取持久 OSD blank 状态')
                if current != target:
                    self.write(name, target)
            if not blank:
                self.path(OSD_SAVED).unlink()
        if self.blanked == blank:
            return
        for name in ('fb0', 'fb1'):
            path = f'/sys/class/graphics/{name}/blank'
            if self.path(path).exists():
                self.write(path, int(blank))
        self.blanked = blank

    def observe_hpd(self):
        hpd = scalar(self.read(TX + 'hpd_state'))
        if hpd not in (0, 1):
            raise ValueError('无法读取 HDMI OUT HPD')
        if self.last_hpd is not None and hpd != self.last_hpd:
            self.sink_changed()
        self.last_hpd = hpd

    def sink_changed(self):
        self.reconnecting = True
        self.connected_identity = None
        self.mode_key = self.pending_key = self.rate_choice = None
        self.rate_samples.clear()
        self.readback_bad_since = None
        self.blanked = None

    def drain_hotplug(self, events):
        for unused in range(256):
            try:
                payload, sender = events.recvfrom(8192)
            except BlockingIOError:
                return
            except OSError as error:
                if error.errno == errno.ENOBUFS:
                    self.sink_changed()
                print(str(error), file=sys.stderr, flush=True)
                return
            fields = dict(item.split('=', 1) for item in payload.decode('utf-8', errors='replace').split('\0') if '=' in item)
            if sender[0] == 0 and fields.get('SUBSYSTEM') == 'amhdmitx' and fields.get('hdmitx_hpd') in ('0', '1'):
                self.sink_changed()

    def read_tx(self):
        raw = {name: self.path(TX + name).read_text()
               for name in ('disp_mode', 'attr', 'frac_rate_policy', 'ready')}
        fields = parse_fields(raw['disp_mode'])
        return {'mode': canonical_mode(fields.get('sname', fields.get('name', ''))),
                'color': canonical_color(raw['attr']), 'fractional': scalar(raw['frac_rate_policy']),
                'rate': scalar(fields.get('h/v_freq', '').split('/')[-1]),
                'ready': scalar(raw['ready']), 'raw': raw}

    def tx_mismatches(self, actual, mode, fractional):
        expected_rate = round(int(re.search(r'p(\d+)hz', mode)[1]) * 1000 / (1.001 if fractional else 1))
        expected = {'mode': mode, 'color': ('444', 8), 'fractional': int(fractional), 'ready': 1}
        mismatch = {name: {'expected': value, 'actual': actual[name]} for name, value in expected.items()
                    if actual[name] != value}
        if actual['rate'] is None or abs(actual['rate'] - expected_rate) > 1:
            mismatch['rate'] = {'expected': expected_rate, 'actual': actual['rate']}
        return mismatch

    def follow_mode(self, input_state, mode, fractional, actual):
        now = time.monotonic()
        key = (input_state['width'], input_state['height'], mode, fractional, self.monitor_identity)
        mismatch = self.tx_mismatches(actual, mode, fractional)
        if key != self.mode_key:
            if not {name: value for name, value in mismatch.items() if name != 'ready'}:
                self.mode_key = key
                self.pending_key = None
            else:
                if key != self.pending_key:
                    self.pending_key, self.pending_since = key, now
                if now - self.pending_since < 2:
                    return None
                print(json.dumps({'event': 'modeset', 'reason': 'input-or-monitor-change',
                                  'previous': self.mode_key, 'desired': key, 'input': input_state,
                                  'mismatch': mismatch, 'raw': actual['raw']}), file=sys.stderr, flush=True)
                self.mode_key, self.pending_key = key, None
                self.write(VIDEO + 'disable_video', 1)
                self.write(TX + 'frac_rate_policy', int(fractional))
                self.write('/sys/class/display/mode', mode)
                self.write(TX + 'test_attr', '444,8bit')
                self.write(TX + 'disp_mode', mode)
                actual = self.read_tx()
                mismatch = self.tx_mismatches(actual, mode, fractional)
        else:
            self.pending_key = None
        if mismatch != self.last_mismatch:
            if mismatch:
                print(json.dumps({'event': 'tx-readback-mismatch', 'mismatch': mismatch,
                                  'raw': actual['raw']}), file=sys.stderr, flush=True)
            self.last_mismatch = mismatch
        if mismatch:
            if self.readback_bad_since is None:
                self.readback_bad_since = now
            if now - self.readback_bad_since >= 2:
                self.update(VIDEO + 'disable_video', 1)
            if set(mismatch) != {'ready'} or now - self.readback_bad_since >= 2:
                return None
        else:
            self.readback_bad_since = None
        return actual

    def tick(self, enabled):
        self.observe_hpd()
        self.blank(enabled)
        state = self.snapshot(enabled)
        if not enabled:
            self.update(VIDEO + 'disable_video', 1)
            return state
        if state['state'] != 'starting':
            self.mode_key = self.pending_key = self.rate_choice = None
            self.rate_samples.clear()
            self.readback_bad_since = None
            self.update(VIDEO + 'disable_video', 1)
            return state
        input_state = state['input']
        if self.reconnecting or (self.connected_identity is not None and self.connected_identity != self.monitor_identity):
            self.mode_key = self.pending_key = None
            self.sink_changed_at = time.monotonic()
            self.reconnecting = False
        self.connected_identity = self.monitor_identity
        if self.sink_changed_at is not None and time.monotonic() - self.sink_changed_at < 2:
            self.update(VIDEO + 'disable_video', 1)
            return state
        if input_state['hdr'] in ('Dolby Vision', 'Unknown HDR'):
            self.update(VIDEO + 'disable_video', 1)
            state['state'] = 'unsupported-format'
            state['reason'] = ('暂不支持 Dolby Vision 画面，声音仍可播放。'
                               if input_state['hdr'] == 'Dolby Vision'
                               else '暂不支持此 HDR 输入格式，声音仍可播放。')
            return state
        if not self.capture_ready:
            self.update(VIDEO + 'disable_video', 1)
            state['state'] = 'video-error'
            state['reason'] = '已检测到输入信号，但采集画面暂不可用，声音仍可播放。'
            return state
        mapped = input_state['hdr'] != 'SDR'
        if mapped:
            mapping = self.path('/sys/class/vdin/vdin0/hdr_sdr')
            if not mapping.exists() or mapping.read_text().strip() != '1':
                self.update(VIDEO + 'disable_video', 1)
                state['state'] = 'unsupported-format'
                state['reason'] = '当前 HDR 显示路径尚未就绪，声音仍可播放。'
                return state
        actual = self.read_tx()
        preferred = self.rate_choice
        if preferred is None and actual['mode'] and actual['fractional'] in (0, 1):
            preferred = (int(re.search(r'p(\d+)hz', actual['mode'])[1]), bool(actual['fractional']))
        geometry = (input_state['width'], input_state['height'])
        if geometry != self.rate_geometry:
            self.rate_samples.clear()
            self.rate_geometry = geometry
        self.rate_samples.append(input_state['refreshHz'])
        stable_input = dict(input_state, refreshHz=median(self.rate_samples))
        mode, width, height, fractional = select_mode(stable_input, display_modes(self.read(TX + 'disp_cap')), preferred)
        if '444,8bit' not in self.read(TX + 'dc_cap').splitlines():
            raise ValueError('显示器不支持已验证的 YCbCr444 8-bit 输出')
        actual = self.follow_mode(input_state, mode, fractional, actual)
        if actual is None:
            return state
        self.rate_choice = (int(re.search(r'p(\d+)hz', mode)[1]), fractional)
        self.update(VIDEO + 'axis', f'0 0 {width - 1} {height - 1}')
        self.update(VIDEO + 'disable_video', 0)
        frame = int(self.read('/sys/module/aml_media/parameters/display_frame_count'))
        now = time.monotonic()
        if frame != self.last_frame:
            self.last_progress = now if self.last_frame is not None else None
            self.last_frame = frame
        if self.last_progress is None or now - self.last_progress > 2:
            state['state'] = 'starting'
            return state
        state['output'] = {'width': width, 'height': height, 'refreshHz': actual['rate'] / 1000,
                           'colorFormat': 'YCbCr444 8-bit limited',
                           'scaled': width != input_state['width'] or height != input_state['height'],
                           'hdrToSdr': mapped}
        state['state'] = 'running'
        return state

    def status(self):
        if not self.supported():
            return {'supported': False, 'enabled': False, 'audio': False, 'state': 'unsupported'}
        requested = self.load(RUNTIME + 'request.json')
        if requested is None:
            return self.snapshot(False)
        observed = self.load(RUNTIME + 'state.json')
        if not observed or observed.get('revision') != requested['revision'] or time.monotonic() - observed['heartbeat'] > 4:
            raise ValueError('透传控制服务未响应')
        state = dict(observed['state'], audio=requested.get('audio', False))
        audio = self.load(RUNTIME + 'audio-state.json', {})
        fallback = 'starting' if time.monotonic() - requested['revision'] / 1e9 < 4 else 'error'
        state['audioState'] = 'off' if not state['audio'] else (
            audio.get('state', 'starting') if audio.get('revision') == requested['revision']
            and time.monotonic() - audio.get('heartbeat', 0) < 4 else fallback)
        return state

    def set(self, enabled, audio):
        if not self.supported():
            raise ValueError('当前内核或 VFM 路由未通过透传资格验证')
        if audio and not self.path('/usr/libexec/vim4_passthrough_audio.py').is_file():
            raise ValueError('音频控制服务未安装，未更改当前设置')
        request = {'enabled': enabled, 'audio': audio, 'revision': time.monotonic_ns()}
        previous = self.load(RUNTIME + 'request.json')
        atomic_json(self.path(RUNTIME + 'request.json'), request)
        try:
            units = ['vim4-passthrough.service'] + (['vim4-passthrough-audio.service'] if audio else [])
            self.run(['systemctl', 'start', *units], check=True, timeout=3, capture_output=True)
            deadline = time.monotonic() + 6
            while time.monotonic() < deadline:
                observed = self.load(RUNTIME + 'state.json')
                if observed and observed.get('revision') == request['revision']:
                    if observed.get('error'):
                        raise ValueError(observed['error'])
                    return self.status()
                time.sleep(.05)
            raise ValueError('等待透传控制超时')
        except Exception:
            rollback = dict(previous or {'enabled': False})
            rollback['revision'] = time.monotonic_ns()
            atomic_json(self.path(RUNTIME + 'request.json'), rollback)
            deadline = time.monotonic() + 1
            while time.monotonic() < deadline:
                observed = self.load(RUNTIME + 'state.json')
                if observed and observed.get('revision') == rollback['revision']:
                    break
                time.sleep(.05)
            raise

    def cycle(self, request):
        observed = {'revision': request['revision']}
        try:
            observed['state'] = self.tick(request['enabled'])
            self.last_error = None
        except (OSError, ValueError) as error:
            for recover in (lambda: self.blank(request['enabled']),
                            lambda: self.update(VIDEO + 'disable_video', 1)):
                try:
                    recover()
                except (OSError, ValueError) as recovery_error:
                    print(str(recovery_error), file=sys.stderr, flush=True)
            observed['error'] = str(error)
            try:
                state = self.snapshot(request['enabled'])
            except (OSError, ValueError):
                state = {'supported': True, 'enabled': request['enabled'], 'audio': False,
                         'state': 'starting' if request['enabled'] else 'off'}
            if request['enabled'] and state.get('input'):
                state.update(state='video-error', reason='已检测到输入信号，但画面暂不可用，声音仍可播放。')
            observed['state'] = state
            if str(error) != self.last_error:
                print(str(error), file=sys.stderr, flush=True)
                self.last_error = str(error)
        observed['heartbeat'] = time.monotonic()
        return observed

    def watch(self):
        with self.path(RUNTIME + 'watch.lock').open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            with socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, 15) as events:
                events.bind((0, 1))
                events.setblocking(False)
                self.watch_loop(events)

    def watch_loop(self, events):
        while True:
            self.drain_hotplug(events)
            request = self.load(RUNTIME + 'request.json', {'enabled': False, 'revision': 0})
            if not self.supported():
                atomic_json(self.path(RUNTIME + 'state.json'), {
                    'revision': request['revision'], 'heartbeat': time.monotonic(),
                    'state': {'supported': False, 'enabled': False, 'audio': False, 'state': 'unsupported'},
                })
                time.sleep(.5)
                continue
            observed = self.cycle(request)
            atomic_json(self.path(RUNTIME + 'state.json'), observed)
            time.sleep(.5)


def main(args):
    controller = VendorPassthrough()
    if args == ['status']:
        print(json.dumps(controller.status()))
    elif len(args) == 3 and args[0] == 'set' and all(value in ('true', 'false') for value in args[1:]):
        print(json.dumps(controller.set(args[1] == 'true', args[2] == 'true')))
    elif args == ['watch']:
        controller.path(RUNTIME).mkdir(mode=0o700, parents=True, exist_ok=True)
        controller.watch()
    elif args == ['prepare']:
        controller.prepare()
    elif args == ['audio-watch']:
        from vim4_passthrough_audio import watch
        watch()
    elif len(args) == 2 and args[0] == 'audio-pcm':
        from vim4_passthrough_audio import bridge
        bridge(int(args[1]))
    else:
        raise ValueError('Invalid passthrough command')


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError) as failure:
        print(str(failure), file=sys.stderr)
        sys.exit(1)
