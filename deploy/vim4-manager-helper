def cpu_opp_domains():
    """Use the live, speed-bin-adjusted OPP voltage when EM is not registered."""
    domains = []
    for policy in sorted(Path('/sys/devices/system/cpu/cpufreq').glob('policy[0-9]*')):
        cpus = [int(cpu) for cpu in policy.joinpath('related_cpus').read_text().split()]
        if not cpus:
            raise ValueError('Empty CPU policy')
        coefficients = []
        for cpu in cpus:
            raw = Path(f'/sys/devices/system/cpu/cpu{cpu}/of_node/dynamic-power-coefficient').read_bytes()
            if len(raw) != 4:
                raise ValueError('Invalid CPU power coefficient')
            coefficients.append(int.from_bytes(raw, 'big'))
        if not coefficients[0] or len(set(coefficients)) != 1:
            raise ValueError('Inconsistent CPU power coefficients')
        powers = {}
        for opp in Path(f'/sys/kernel/debug/opp/cpu{cpus[0]}').glob('opp:*'):
            if opp.joinpath('available').read_text().strip() != 'Y':
                continue
            hz = int(opp.joinpath('rate_hz').read_text())
            uv = int(opp.joinpath('supply-0/u_volt_target').read_text())
            if hz <= 0 or uv <= 0:
                raise ValueError('Invalid CPU operating point')
            # Same C * mV^2 * MHz model as dev_pm_opp_calc_power, in mW.
            powers[hz // 1000] = coefficients[0] * (uv // 1000) ** 2 * (hz // 1000000) / 1e9
        domains.append((cpus, policy.joinpath('stats/time_in_state'), powers))
    return domains


def cpu_power_snapshot():
    """Read the kernel's per-core dynamic power model and interval counters.

    Keep debugfs privileged; never expose arbitrary paths through the helper.
    Abstract energy costs cannot be presented as watts.
    """
    counters = {}
    for line in Path('/proc/stat').read_text().splitlines():
        fields = line.split()
        if fields and re.fullmatch(r'cpu\d+', fields[0]):
            values = [int(v) for v in fields[1:9]]
            if len(values) != 8:
                raise ValueError('Incomplete CPU counters')
            counters[int(fields[0][3:])] = {
                'busy': sum(values) - values[3] - values[4], 'total': sum(values)}
    domains = []
    covered = set()
    models = []
    for domain in sorted(Path('/sys/kernel/debug/energy_model').glob('cpu[0-9]*')):
        units = domain.joinpath('units').read_text().strip()
        if units not in ('milliWatts', 'microWatts'):
            raise ValueError('CPU energy model does not report physical power')
        cpus = []
        for part in domain.joinpath('cpus').read_text().strip().split(','):
            bounds = [int(v) for v in part.split('-')]
            if len(bounds) not in (1, 2) or not 0 <= bounds[0] <= bounds[-1] <= 4095:
                raise ValueError('Invalid CPU domain')
            cpus.extend(range(bounds[0], bounds[-1] + 1))
        residency = Path(f'/sys/devices/system/cpu/cpufreq/policy{cpus[0]}/stats/time_in_state') if cpus else None
        powers = {int(state.name[3:]): int(state.joinpath('power').read_text()) /
                  (1000 if units == 'microWatts' else 1) for state in domain.glob('ps:*')}
        models.append((cpus, residency, powers))
    if not models:
        models = cpu_opp_domains()
    for cpus, residency, powers in models:
        if not cpus or covered.intersection(cpus):
            raise ValueError('Overlapping CPU domains')
        online = [cpu for cpu in cpus if cpu in counters]
        if not online:
            continue
        states = {}
        for line in residency.read_text().splitlines():
            frequency, ticks = (int(v) for v in line.split())
            power = powers.get(frequency, 0)
            if frequency <= 0 or ticks < 0 or power <= 0:
                raise ValueError('Invalid CPU power state')
            states[str(frequency)] = {'ticks': ticks, 'milliwatts': power}
        if not states:
            raise ValueError('No CPU residency counters')
        domains.append({'cpus': {str(cpu): counters[cpu] for cpu in online}, 'states': states})
        covered.update(online)
    if not counters or covered != set(counters):
        raise ValueError('Incomplete CPU energy model')
    return domains




def power_status():
    result = {'vbusPresent': None, 'bootContract': None}
    firmware = firmware_power()
    if firmware is not None:
        result['firmwarePD'] = firmware
    # Packaged and manual board installs use different fixed locations.
    binary = next((p for p in ('/usr/sbin/usb-pd-init', '/usr/local/sbin/usb-pd-init')
                   if Path(p).is_file()), None)
    if binary:
        try:
            data = json.loads(subprocess.check_output([binary, '--status'], text=True,
                                                      stderr=subprocess.DEVNULL, timeout=2))
            if type(data.get('vbusPresent')) is bool:
                result['vbusPresent'] = data['vbusPresent']
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    try:
        invocation = subprocess.check_output(
            ['systemctl', 'show', 'vim4-kvm-pd.service', '-p', 'InvocationID', '--value'],
            text=True, timeout=2).strip()
        if re.fullmatch(r'[0-9a-f]{32}', invocation):
            log = subprocess.check_output(
                ['journalctl', '-b', '_SYSTEMD_INVOCATION_ID=' + invocation,
                 '--no-pager', '-o', 'cat', '-n', '200'], text=True, timeout=2)
            result['bootContract'] = boot_power_contract(log)
    except (OSError, subprocess.SubprocessError):
        pass
    last = previous_contract()
    if last is not None:
        result['lastContract'] = last
    return result


def tailscale_auth_url(url):
    parsed = urllib.parse.urlsplit(url)
    if url and (parsed.scheme not in ('http', 'https') or not parsed.hostname or
                parsed.username is not None or any(c.isspace() for c in url)):
        raise ValueError('invalid Tailscale authorization URL')
    return url


def tailscale_local_api(method, path, data):
    # Keep mutations in the root helper; the manager needs only read access.
    connection = http.client.HTTPConnection('local-tailscaled.sock', timeout=20)
    connection.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.sock.settimeout(20)
    try:
        connection.sock.connect('/var/run/tailscale/tailscaled.sock')
        connection.request(method, '/localapi/v0/' + path, json.dumps(data),
                           {'Content-Type': 'application/json'})
        response = connection.getresponse()
        body = response.read(1 << 20)
        if response.status != 200:
            raise ValueError(f'Tailscale local API failed ({response.status})')
        return json.loads(body)
    finally:
        connection.close()


def tailscale_write_job(action, running, error=''):
    temporary = TAILSCALE_JOB.with_suffix('.tmp')
    temporary.write_text(json.dumps({'action': action, 'running': running, 'error': error}))
    temporary.chmod(0o644)
    temporary.replace(TAILSCALE_JOB)


def tailscale_package(action):
    error = ''
    try:
        (tailscale_install if action == 'install' else tailscale_uninstall)()
    except BaseException as failure:
        error = str(failure) or 'Package operation interrupted'
        raise
    finally:
        tailscale_write_job(action, False, error)


def tailscale_start_package(action):
    # A separate service cgroup survives manager updates and browser disconnects.
    tailscale_write_job(action, True)
    try:
        tailscale_run('systemd-run', '--unit=' + TAILSCALE_PACKAGE_UNIT, '--collect',
                      '--property=RuntimeMaxSec=15min', '/usr/libexec/vim4-manager-helper',
                      'tailscale-package', action)
    except BaseException as failure:
        tailscale_write_job(action, False, str(failure))
        raise


def tailscale_installed():
    return Path('/usr/bin/tailscale').exists() and Path('/usr/sbin/tailscaled').exists()


def tailscale_run(*args, timeout=30, check=True):
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                            env={**os.environ, 'LC_ALL': 'C', 'DEBIAN_FRONTEND': 'noninteractive'})
    if check and result.returncode:
        raise ValueError(f'{args[0]} {args[1]} failed: {result.stderr.strip()[-300:]}')
    return result


def tailscale_status():
    state = {'installed': tailscale_installed(), 'running': False, 'backendState': '', 'authURL': '',
             'hostName': '', 'dnsName': '', 'ips': [], 'tailnet': '', 'controlURL': TAILSCALE_CONTROL,
             'version': '', 'peers': 0, 'peersOnline': 0, 'devices': []}
    if not state['installed']:
        return state
    result = tailscale_run('tailscale', 'status', '--json', timeout=4, check=False)
    if not result.stdout.strip():
        if result.returncode:
            return state
        raise ValueError('tailscale returned empty state')
    # NeedsLogin can return a nonzero exit code with valid daemon state.
    status = json.loads(result.stdout)
    peer = status.get('Peer') or {}
    self = status.get('Self') or {}
    state.update(running=True, backendState=status.get('BackendState', ''),
                 authURL=tailscale_auth_url(status.get('AuthURL') or ''), hostName=self.get('HostName', ''),
                 dnsName=(self.get('DNSName') or '').rstrip('.'),
                 ips=status.get('TailscaleIPs') or self.get('TailscaleIPs') or [],
                 tailnet=(status.get('CurrentTailnet') or {}).get('Name', ''),
                 version=status.get('Version', ''), peers=len(peer),
                 peersOnline=sum(bool(p.get('Online')) for p in peer.values()))
    for p in peer.values():
        last_seen = p.get('LastSeen') or ''
        if last_seen.startswith('0001-01-01'):
            last_seen = ''
        state['devices'].append({
            'id': p.get('ID') or '', 'hostName': p.get('HostName') or '',
            'dnsName': (p.get('DNSName') or '').rstrip('.'), 'os': p.get('OS') or '',
            'ips': p.get('TailscaleIPs') or [], 'online': bool(p.get('Online')),
            'lastSeen': last_seen, 'curAddr': p.get('CurAddr') or '', 'relay': p.get('Relay') or '',
            'exitNode': bool(p.get('ExitNode')), 'active': bool(p.get('Active')),
        })
    state['devices'].sort(key=lambda device: (not device['online'], device['hostName'].casefold()))
    prefs = tailscale_run('tailscale', 'debug', 'prefs', timeout=4, check=False)
    if prefs.returncode == 0:
        state['controlURL'] = json.loads(prefs.stdout).get('ControlURL') or TAILSCALE_CONTROL
    return state


def tailscale_ping_output(output):
    result = {'reachable': False, 'path': '', 'via': '', 'latencyMs': [], 'lost': 0, 'sent': 0}
    for line in output.splitlines():
        pong = re.fullmatch(r'pong from .+ via (\S+) in ([0-9]+(?:\.[0-9]+)?)ms', line.strip())
        if pong:
            via, latency = pong.groups()
            if via.startswith('DERP(') and via.endswith(')'):
                path, via = 'derp', via[5:-1]
            elif via.startswith('peer-relay(') and via.endswith(')'):
                path, via = 'peer-relay', via[11:-1]
            else:
                path = 'direct'
            result.update(reachable=True, path=path, via=via)
            result['latencyMs'].append(float(latency))
        elif 'timed out' in line:
            result['lost'] += 1
    result['sent'] = len(result['latencyMs']) + result['lost']
    return result


def tailscale_ping(ip):
    address = ipaddress.ip_address(ip)
    if '%' in ip or not any(address in network for network in TAILSCALE_NETWORKS):
        raise ValueError('ping requires a Tailscale IP address')
    # Read Peer directly: Self and arbitrary addresses in the tailnet ranges
    # must never become probe targets, even when called outside the Go API.
    status = tailscale_run('tailscale', 'status', '--json', timeout=4, check=False)
    peers = (json.loads(status.stdout).get('Peer') or {}).values()
    if not any(address == ipaddress.ip_address(peer_ip)
               for peer in peers for peer_ip in (peer.get('TailscaleIPs') or [])):
        raise ValueError('ping target is not a current Tailscale peer')
    result = tailscale_run('tailscale', 'ping', '--until-direct=false', '--c', '4', '--timeout', '3s',
                          str(address), timeout=20, check=False)
    return tailscale_ping_output(result.stdout + '\n' + result.stderr)


def tailscale_install():
    if not tailscale_installed():
        release = ''
        for line in Path('/etc/os-release').read_text().splitlines():
            if line.startswith('VERSION_CODENAME='):
                release = line.split('=', 1)[1].strip('"')
        if not re.fullmatch(r'[a-z]+', release):
            raise ValueError('unknown Ubuntu release')
        with urllib.request.urlopen(f'{TAILSCALE_REPOSITORY}/{release}.noarmor.gpg', timeout=30) as response:
            key = response.read(65536)
        TAILSCALE_KEYRING.write_bytes(key)
        TAILSCALE_KEYRING.chmod(0o644)
        TAILSCALE_SOURCES.write_text(f'deb [signed-by={TAILSCALE_KEYRING}] '
                                    f'{TAILSCALE_REPOSITORY} {release} main\n')
        # Refresh only Tailscale's signed source, leaving other repositories alone.
        tailscale_run('apt-get', 'update', '-o', f'Dir::Etc::sourcelist={TAILSCALE_SOURCES}',
                      '-o', 'Dir::Etc::sourceparts=-', '-o', 'APT::Get::List-Cleanup=0', timeout=180)
        tailscale_run('apt-get', 'install', '-y', '--no-install-recommends', 'tailscale', timeout=600)
    tailscale_run('systemctl', 'enable', '--now', 'tailscaled.service')


def tailscale_uninstall():
    # Also recover partially installed packages whose executables are missing.
    tailscale_run('systemctl', 'disable', '--now', 'tailscaled.service', check=False)
    tailscale_run('apt-get', 'remove', '-y', 'tailscale', timeout=300)
    for path in (TAILSCALE_SOURCES, TAILSCALE_KEYRING):
        path.unlink(missing_ok=True)


def tailscale_login(url, previous=''):
    tailscale_run('systemctl', 'enable', '--now', 'tailscaled.service', timeout=20)
    current = tailscale_status()
    if (current['backendState'] in ('Running', 'Stopped', 'Starting', 'NeedsMachineAuth') and
            current['controlURL'] != url and previous != current['controlURL']):
        raise ValueError('请确认切换控制服务器，并重新提交当前 controlURL')
    # A fixed unit bounds login to one process, including retries after a timeout.
    tailscale_run('systemctl', 'stop', TAILSCALE_LOGIN_UNIT, check=False)
    tailscale_run('systemd-run', '--unit=' + TAILSCALE_LOGIN_UNIT, '--collect',
                  '--property=RuntimeMaxSec=10min', 'tailscale', 'login', '--login-server=' + url,
                  '--accept-dns=false', '--timeout=10m')
    deadline = time.monotonic() + 30
    while (remaining := deadline - time.monotonic()) > 0:
        try:
            # The detached login may not have applied its preferences yet.
            # Read preferences first so an old server's state cannot complete login.
            prefs = tailscale_run('tailscale', 'debug', 'prefs', timeout=min(2, remaining), check=False)
            control = (json.loads(prefs.stdout).get('ControlURL') or TAILSCALE_CONTROL) if prefs.returncode == 0 else ''
            remaining = deadline - time.monotonic()
            if remaining > 0:
                result = tailscale_run('tailscale', 'status', '--json', timeout=min(2, remaining), check=False)
                status = json.loads(result.stdout or '{}')
                if control == url and (status.get('AuthURL') or status.get('BackendState') == 'Running'):
                    return {'authURL': tailscale_auth_url(status.get('AuthURL') or '')}
        except subprocess.TimeoutExpired:
            pass
        time.sleep(min(0.5, max(0, deadline - time.monotonic())))
    raise ValueError('tailscale did not provide an authorization URL within 30 seconds')


def tailscale_command(argv):
    previous = ''
    match argv:
        case ['tailscale-package', action] if action in ('install', 'uninstall'):
            tailscale_package(action)
            return {}
        case ['tailscale-login', url, previous] if TAILSCALE_URL.fullmatch(url) and TAILSCALE_URL.fullmatch(previous):
            action = 'login'
        case ['tailscale-login', url] if TAILSCALE_URL.fullmatch(url):
            action = 'login'
        case ['tailscale-ping', ip]:
            action = 'ping'
        case [name] if name in ('tailscale-status', 'tailscale-install', 'tailscale-uninstall',
                               'tailscale-up', 'tailscale-down', 'tailscale-logout'):
            action = name.removeprefix('tailscale-')
        case _:
            raise ValueError('usage: tailscale-status|install|uninstall|up|down|logout | tailscale-login URL [PREVIOUS_URL] | tailscale-ping IP')
    if action not in ('status', 'install', 'uninstall') and not tailscale_installed():
        raise ValueError('tailscale is not installed')
    if action == 'status':
        return tailscale_status()
    if action == 'ping':
        return tailscale_ping(ip)
    if TAILSCALE_JOB.exists():
        job = json.loads(TAILSCALE_JOB.read_text())
        if job.get('running') and tailscale_run('systemctl', 'is-active', '--quiet',
                                               TAILSCALE_PACKAGE_UNIT, check=False).returncode == 0:
            raise ValueError('Another tailscale package operation is in progress')
    if action != 'login':
        tailscale_run('systemctl', 'stop', TAILSCALE_LOGIN_UNIT, check=False)
    if action in ('install', 'uninstall'):
        tailscale_start_package(action)
    elif action == 'login':
        return tailscale_login(url, previous)
    elif action == 'up':
        tailscale_run('systemctl', 'enable', '--now', 'tailscaled.service', timeout=20)
        tailscale_local_api('PATCH', 'prefs', {'WantRunning': True, 'WantRunningSet': True})
    else:
        tailscale_run('tailscale', action)
    return {}


def disk_name(name):
    if not vim4media.valid_disk_name(name):
        raise ValueError('数据盘名称无效（需以 .img 结尾）')
    return name


def disk_label(label):
    label = label.strip()
    if not re.fullmatch(r'[A-Z0-9 _-]{1,11}', label):
        raise ValueError('卷标需为 1–11 个大写字母、数字、空格、下划线或连字符')
    return label


def fat_path(path, root=True):
    if path == '/' and root:
        return path
    parts = path[1:].split('/')
    if (not path.startswith('/') or len(parts) > 16 or
            any(p in ('', '.', '..') or len(p) > 255 or
                any(ord(c) < 32 or 127 <= ord(c) < 160 or c in '\\:*?"<>|' for c in p)
                for p in parts)):
        raise ValueError('FAT 路径无效')
    return path


def fat_arg(path):
    # mtools interprets bracket expressions even without a shell.
    return '::' + path.replace('[', '\\[').replace(']', '\\]')


def disk_tool(fd, command, *args, check=True, stdout=subprocess.PIPE):
    result = subprocess.run([command, '-i', f'/proc/self/fd/{fd}', *args],
                            pass_fds=(fd,), stdin=subprocess.DEVNULL, stdout=stdout,
                            stderr=subprocess.PIPE,
                            env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C.UTF-8',
                                 'TZ': 'UTC', 'MTOOLS_SKIP_CHECK': '1'})
    if check and result.returncode:
        raise ValueError(result.stderr.decode(errors='replace')[:16384].strip() or '磁盘操作失败')
    return result


@contextmanager
def allocation_lock():
    fd = os.open(ALLOCATION_LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        if os.fstat(fd).st_uid != 0:
            raise ValueError('Invalid allocation lock owner')
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield
    finally:
        os.close(fd)


def reserve_space(path, size):
    if shutil.disk_usage(path).free - size < RESERVE_BYTES:
        raise ValueError('操作后系统需保留至少 2 GiB 可用空间')


def disk_info(fd):
    result = disk_tool(fd, 'mdir', '::/', check=False)
    if result.returncode:
        return None, None
    output = result.stdout.decode(errors='replace')
    label = re.search(r'Volume in drive .*? is (.*)', output)
    free = re.search(r'([\d ]+) bytes free', output)
    return (label.group(1).strip() if label else '',
            int(free.group(1).replace(' ', '')) if free else None)


@contextmanager
def snapshot_directory(name, create=False):
    disk_name(name)
    root = vim4media.SNAPSHOT_DIR
    if create:
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
    with ExitStack() as stack:
        parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        stack.callback(os.close, parent)
        if create:
            try:
                os.mkdir(name, 0o700, dir_fd=parent)
            except FileExistsError:
                pass
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        stack.callback(os.close, fd)
        yield fd


def snapshot_list(name):
    result = []
    try:
        with snapshot_directory(name) as directory:
            for identifier in os.listdir(directory):
                if not SNAPSHOT_ID.fullmatch(identifier):
                    continue
                info = os.stat(identifier, dir_fd=directory, follow_symlinks=False)
                if stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                    result.append(dict(id=identifier, time=info.st_mtime, size=info.st_size))
    except FileNotFoundError:
        pass
    return sorted(result, key=lambda item: item['id'], reverse=True)


def disk_list():
    disks = []
    for image in vim4media.catalog(['data']):
        name = image['name']
        item = dict(name=name, size=image['size'], mtime=None, label=None, freeBytes=None,
                    attached=False, readOnly=False, editing=False, snapshots=snapshot_list(name))
        try:
            with vim4media.read_disk(name) as (fd, attached):
                item.update(mtime=os.fstat(fd).st_mtime, attached=attached)
                if attached:
                    item['readOnly'] = vim4media.LUN_FILE.with_name('ro').read_text().strip() == '1'
                item['label'], item['freeBytes'] = disk_info(fd)
        except ValueError:
            item['editing'] = True
            item['mtime'] = (vim4media.DATA_DIR / name).stat().st_mtime
        disks.append(item)
    return disks


def format_disk(fd, label, *, preserve_label=False):
    if preserve_label:
        # Existing NanoKVM disks use "Vim4KVM". Preserve that spelling on resize;
        # new labels still follow the manager's uppercase convention.
        if not re.fullmatch(r'[A-Za-z0-9 _-]{1,11}', label):
            raise ValueError('无法安全保留此卷标')
    else:
        label = disk_label(label)
    subprocess.run(['mkfs.vfat', '-F', '32', '-n', label, f'/proc/self/fd/{fd}'],
                   pass_fds=(fd,), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                   stderr=subprocess.PIPE, check=True,
                   env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
    os.fsync(fd)


def disk_create(name, size, label):
    disk_name(name)
    label = disk_label(label)
    size = int(size)
    if not 64 <= size <= 32768:
        raise ValueError('数据盘容量需在 64–32768 MiB 之间')
    vim4media.DATA_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    with allocation_lock():
        if len(vim4media.catalog(['data'])) >= 8:
            raise ValueError('最多创建 8 个数据盘')
        reserve_space(vim4media.DATA_DIR, size << 20)
        with vim4media.edit_disk(name, create=True) as fd:
            try:
                os.posix_fallocate(fd, 0, size << 20)
                format_disk(fd, label)
            except BaseException:
                (vim4media.DATA_DIR / name).unlink()
                raise


def disk_ls(fd, path):
    output = disk_tool(fd, 'mdir', '-a', fat_arg(path.rstrip('/') + '/')).stdout.decode(errors='replace')
    entries = []
    for line in output.splitlines():
        match = re.fullmatch(r'(.{8}) (.{3})\s+(<DIR>|\d+)\s+(\d{4}-\d{2}-\d{2})\s+(\d{1,2}:\d{2})(?:\s+(.*))?', line)
        if not match:
            continue
        base, ext, size, day, clock, long_name = match.groups()
        name = long_name or base.strip() + ('.' + ext.strip() if ext.strip() else '')
        if name in ('.', '..'):
            continue
        stamp = datetime.strptime(day + ' ' + clock, '%Y-%m-%d %H:%M').replace(tzinfo=timezone.utc)
        entries.append(dict(name=name, dir=size == '<DIR>', size=0 if size == '<DIR>' else int(size),
                            mtime=stamp.timestamp()))
    return entries


def disk_put(fd, path, size, overwrite, source):
    size = int(size)
    if not 0 <= size <= (1 << 32) - 1 or overwrite not in ('0', '1'):
        raise ValueError('上传大小或覆盖选项无效（FAT32 单文件最大 4 GiB-1）')
    _, free = disk_info(fd)
    if free is None or size > free:
        raise ValueError('数据盘可用空间不足')
    parent, name = path.rsplit('/', 1)
    existing = next((e for e in disk_ls(fd, parent or '/') if e['name'].casefold() == name.casefold()), None)
    if existing and (overwrite == '0' or existing['dir']):
        raise ValueError('目标已存在')
    DISK_STAGING.mkdir(mode=0o700, parents=True, exist_ok=True)
    with allocation_lock(), ExitStack() as stack:
        directory = os.open(DISK_STAGING, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        stack.callback(os.close, directory)
        info = os.fstat(directory)
        if info.st_uid != 0 or info.st_mode & 0o077:
            raise ValueError('Invalid staging directory owner or mode')
        reserve_space(f'/proc/self/fd/{directory}', size)
        with tempfile.TemporaryFile(dir=f'/proc/self/fd/{directory}') as staged:
            if size:
                os.posix_fallocate(staged.fileno(), 0, size)
            remaining = size
            while remaining:
                chunk = source.read(min(1 << 20, remaining))
                if not chunk:
                    raise ValueError('上传未完成')
                staged.write(chunk)
                remaining -= len(chunk)
            if source.read(1):
                raise ValueError('上传超过声明大小')
            staged.flush()
            # The staging file has no name and is inherited only by mcopy.
            result = subprocess.run(['mcopy', '-i', f'/proc/self/fd/{fd}', '-o' if overwrite == '1' else '-n',
                                     f'/proc/self/fd/{staged.fileno()}', '::' + path],
                                    pass_fds=(fd, staged.fileno()), stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C.UTF-8', 'TZ': 'UTC',
                                         'MTOOLS_SKIP_CHECK': '1'})
            if result.returncode:
                raise ValueError(result.stderr.decode(errors='replace')[:16384])
    os.fsync(fd)


def copy_image(source, destination):
    os.lseek(source, 0, os.SEEK_SET)
    os.lseek(destination, 0, os.SEEK_SET)
    with os.fdopen(os.dup(source), 'rb') as reader, os.fdopen(os.dup(destination), 'wb') as writer:
        shutil.copyfileobj(reader, writer, 1 << 20)
        writer.flush()
    os.fsync(destination)


@contextmanager
def staged_image(directory):
    # Hidden, non-.img names are never catalogued or offered for restore, even
    # after SIGKILL. The final name is published only after fsync succeeds.
    target, path = tempfile.mkstemp(prefix='.pending-', dir=f'/proc/self/fd/{directory}')
    temporary = Path(path).name
    try:
        yield target, temporary
    finally:
        os.close(target)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def publish_disk(name, original, directory, temporary, target):
    os.fsync(target)
    # Readers opening before rename must fail on the old inode lock or identity
    # check; readers opening afterwards see a fully written image.
    with media_locks():
        current = os.stat(name, dir_fd=directory, follow_symlinks=False)
        old = os.fstat(original)
        if (current.st_dev, current.st_ino) != (old.st_dev, old.st_ino):
            raise ValueError('数据盘已改变，请重试')
        if vim4media.is_attached(original):
            raise ValueError('数据盘已挂载到被控电脑，请先安全弹出')
        fcntl.flock(target, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)


def snapshot_disk(name, fd, *, allocation_held=False):
    with ExitStack() as stack:
        if not allocation_held:
            stack.enter_context(allocation_lock())
        directory = stack.enter_context(snapshot_directory(name, create=True))
        if len(snapshot_list(name)) >= 3:
            raise ValueError('每个数据盘最多保留 3 个快照，请先删除旧快照')
        size = os.fstat(fd).st_size
        reserve_space(f'/proc/self/fd/{directory}', size)
        identifier = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ.img')
        with staged_image(directory) as (target, temporary):
            os.posix_fallocate(target, 0, size)
            copy_image(fd, target)
            os.rename(temporary, identifier, src_dir_fd=directory, dst_dir_fd=directory)
            os.fsync(directory)
        return {'id': identifier}


def snapshot_action(name, identifier, fd=None):
    if not SNAPSHOT_ID.fullmatch(identifier):
        raise ValueError('快照标识无效')
    with snapshot_directory(name) as directory:
        if fd is None:
            os.unlink(identifier, dir_fd=directory)
        else:
            source = os.open(identifier, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            try:
                info = os.fstat(source)
                # Expansion snapshots retain the previous capacity. Restoring
                # one deliberately restores that capacity as well as its bytes.
                if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or
                        not 512 <= info.st_size <= 32768 << 20):
                    raise ValueError('快照类型或容量不匹配')
                with allocation_lock(), vim4media._directory('data') as data:
                    reserve_space(f'/proc/self/fd/{data}', info.st_size)
                    with staged_image(data) as (target, temporary):
                        os.posix_fallocate(target, 0, info.st_size)
                        copy_image(source, target)
                        publish_disk(name, fd, data, temporary, target)
            finally:
                os.close(source)


def check_fat(fd):
    result = subprocess.run(['fsck.vfat', '-n', f'/proc/self/fd/{fd}'], pass_fds=(fd,),
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if result.returncode:
        raise ValueError('FAT 检查失败: ' + result.stdout.decode(errors='replace')[:16384])


def resize_disk(name, fd, size):
    size = int(size)
    old_size = os.fstat(fd).st_size
    if not 64 <= size <= 32768 or size << 20 <= old_size:
        raise ValueError('只能扩容到 64–32768 MiB，且必须大于当前容量')
    boot = os.pread(fd, 512, 0)
    # Support whole-image FAT32 only, not partition tables or FAT12/16.
    if (boot[82:90] != b'FAT32   ' or boot[510:512] != b'\x55\xaa' or
            int.from_bytes(boot[17:19], 'little') != 0 or
            int.from_bytes(boot[22:24], 'little') != 0):
        raise ValueError('仅支持无分区表的 FAT32 数据盘')
    check_fat(fd)
    label, free = disk_info(fd)
    if label is None or free is None:
        raise ValueError('无法读取 FAT32 卷标或可用空间')
    # Refuse labels we cannot round-trip through mkfs's locale safely.
    if label and not re.fullmatch(r'[A-Za-z0-9 _-]{1,11}', label):
        raise ValueError('无法安全保留此卷标')
    with allocation_lock(), vim4media._directory('data') as directory:
        reserve_space(f'/proc/self/fd/{directory}', size << 20)
        with staged_image(directory) as (target, temporary):
            os.posix_fallocate(target, 0, size << 20)
            format_disk(target, label or 'NO NAME', preserve_label=True)
            if not label:
                disk_tool(target, 'mlabel', '-c', '::')
            # Two explicit mtools drives copy FAT-to-FAT, including hidden files,
            # empty directories, attributes and timestamps, without a kernel mount.
            with tempfile.NamedTemporaryFile(mode='w', prefix='vim4-mtools-') as config:
                config.write(f'drive a: file="/proc/self/fd/{fd}"\n'
                             f'drive b: file="/proc/self/fd/{target}"\n')
                config.flush()
                entries = disk_tool(fd, 'mdir', '-b', '-a', '::/').stdout
                if entries.strip():
                    result = subprocess.run(['mcopy', '-s', '-p', '-m', '-Q', 'a:/', 'b:/'],
                                            pass_fds=(fd, target), stdin=subprocess.DEVNULL,
                                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                            env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin',
                                                 'LC_ALL': 'C.UTF-8', 'TZ': 'UTC',
                                                 'MTOOLSRC': config.name})
                    if result.returncode:
                        raise ValueError(result.stderr.decode(errors='replace')[:16384])
            check_fat(target)
            new_label, new_free = disk_info(target)
            if new_label != label or new_free is None or new_free <= free:
                raise ValueError('扩容后的卷标或可用空间校验失败')
            snapshot = snapshot_disk(name, fd, allocation_held=True)
            publish_disk(name, fd, directory, temporary, target)
            return dict(ok=True, snapshot=snapshot['id'])


def disk_command(argv):
    match argv:
        case ['disk-list']:
            return disk_list()
        case ['disk-create', name, size, label]:
            disk_create(name, size, label)
        case ['disk-check', name]:
            with vim4media.read_disk(disk_name(name)) as (fd, _):
                with tempfile.TemporaryFile() as output:
                    result = subprocess.run(['fsck.vfat', '-n', f'/proc/self/fd/{fd}'], pass_fds=(fd,),
                                            stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT)
                    output.seek(0)
                    return dict(ok=result.returncode == 0, output=output.read(16384).decode(errors='replace'))
        case ['disk-ls', name, path] | ['disk-get', name, path]:
            fat_path(path, root=argv[0] == 'disk-ls')
            with vim4media.read_disk(disk_name(name)) as (fd, stale):
                if argv[0] == 'disk-ls':
                    return dict(path=path, stale=stale, entries=disk_ls(fd, path))
                disk_tool(fd, 'mtype', fat_arg(path), stdout=sys.stdout.buffer)
        case ['disk-image', name]:
            with ExitStack() as stack:
                with media_locks():
                    fd, attached = stack.enter_context(vim4media.read_disk(disk_name(name)))
                    if attached and vim4media.LUN_FILE.with_name('ro').read_text().strip() != '1':
                        raise ValueError('数据盘已可写挂载，请先安全弹出')
                    # Prevent a new writable attachment without holding global locks during export.
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                with os.fdopen(os.dup(fd), 'rb') as source:
                    shutil.copyfileobj(source, sys.stdout.buffer, 1 << 20)
        case ['disk-snapshot-delete', name, identifier]:
            with allocation_lock():
                snapshot_action(name, identifier)
        case [command, name, *args] if command in ('disk-delete', 'disk-format', 'disk-label',
                                                   'disk-put', 'disk-mkdir', 'disk-rm', 'disk-mv',
                                                   'disk-snapshot', 'disk-restore', 'disk-resize'):
            with vim4media.edit_disk(disk_name(name)) as fd:
                match [command, *args]:
                    case ['disk-resize', size]:
                        return resize_disk(name, fd, size)
                    case ['disk-delete'] | ['disk-delete', '0'] | ['disk-delete', '1']:
                        if args != ['1']:
                            for snapshot in snapshot_list(name):
                                snapshot_action(name, snapshot['id'])
                        (vim4media.DATA_DIR / name).unlink()
                    case ['disk-format', label]:
                        format_disk(fd, label)
                    case ['disk-format', label, '1']:
                        label = disk_label(label)
                        snapshot_disk(name, fd)
                        format_disk(fd, label)
                    case ['disk-label', label]:
                        disk_tool(fd, 'mlabel', '::' + disk_label(label))
                    case ['disk-put', path, size, overwrite]:
                        disk_put(fd, fat_path(path, False), size, overwrite, sys.stdin.buffer)
                    case ['disk-mkdir', path]:
                        disk_tool(fd, 'mmd', '::' + fat_path(path, False))
                    case ['disk-rm', path]:
                        disk_tool(fd, 'mdeltree', fat_arg(fat_path(path, False)))
                    case ['disk-mv', source, target]:
                        # mmove 4.0.43 drops the lower-case flag across directories and
                        # crashes on missing targets; only same-directory renames are offered.
                        source, target = fat_path(source, False), fat_path(target, False)
                        if source.rsplit('/', 1)[0] != target.rsplit('/', 1)[0]:
                            raise ValueError('只能在同一文件夹内重命名')
                        disk_tool(fd, 'mren', fat_arg(source), '::' + target)
                    case ['disk-snapshot']:
                        return snapshot_disk(name, fd)
                    case ['disk-restore', identifier]:
                        snapshot_action(name, identifier, fd)
                    case _:
                        raise ValueError('数据盘命令参数无效')
                os.fsync(fd)
        case _:
            raise ValueError('数据盘命令参数无效')
    return {'ok': True}



def media_active(app):
    if app not in APPS:
        raise ValueError('请选择正在运行的 KVM')
    result = subprocess.run(['systemctl', 'show', '--property=ActiveState', '--value', *APPS.values()],
                            check=True, capture_output=True, text=True, timeout=10)
    states = [line for line in result.stdout.splitlines() if line]
    if len(states) != len(APPS) or [key for key, state in zip(APPS, states) if state == 'active'] != [app]:
        raise ValueError('运行中的 KVM 已改变，请刷新后重试')
    if PIKVM_USB_STATE.exists() != (app == 'pikvm'):
        raise ValueError('USB 配置正在切换，请稍后重试')


def media_mount(app, identifier, cdrom, readonly):
    with media_locks():
        media_active(app)
        if PIKVM_LUN_FILE.read_text().strip():
            raise ValueError('已有虚拟磁盘挂载，请先在被控电脑安全弹出；不会替换现有磁盘')
        cdrom = cdrom or identifier.lower().endswith('.iso')
        readonly = readonly or cdrom
        if app == 'jetkvm' and not readonly:
            raise ValueError('JetKVM 仅支持只读介质')
        fd = media_image(identifier, readonly)
        try:
            attach_media(fd, app, cdrom, readonly)
        finally:
            os.close(fd)


def attach_media(fd, app, cdrom, readonly):
    lun = PIKVM_LUN_FILE.parent
    gadget = lun.parents[2]
    config = gadget / 'configs/c.1'
    disk = config / 'mass_storage.disk0'
    network = config / 'ncm.usb0'
    linked = disk.is_symlink()
    # Nano/Jet's stock profile replaces NCM with storage. One-KVM's explicit
    # HID/network selection must be preserved, including its endpoint budget.
    remove_network = not linked and app in ('nanokvm', 'jetkvm') and network.is_symlink()
    links = [p.name for p in config.iterdir() if p.is_symlink() and p != disk
             and not (remove_network and p == network)]
    endpoints = 1 + sum(2 if name.startswith(('ncm.', 'ecm.', 'rndis.')) else 1 for name in links)
    if endpoints > 5:
        raise ValueError('USB 端点不足，请先在当前 KVM 关闭 USB 网卡、麦克风或一个 HID 功能')
    old = {key: (lun / key).read_text() for key in ('ro', 'cdrom')}
    udc = gadget / 'UDC'
    controller = udc.read_text().strip()
    rebound = not linked and bool(controller)
    try:
        if rebound:
            udc.write_text('\n')
            time.sleep(0.5)
        if remove_network:
            network.unlink()
        (lun / 'cdrom').write_text('1' if cdrom else '0')
        (lun / 'ro').write_text('1' if readonly else '0')
        PIKVM_LUN_FILE.write_text(f'/proc/self/fd/{fd}')
        if not linked:
            disk.symlink_to(gadget / 'functions/mass_storage.disk0')
    except Exception:
        PIKVM_LUN_FILE.write_text('\n')
        for key, value in old.items():
            (lun / key).write_text(value)
        if not linked:
            disk.unlink(missing_ok=True)
        if remove_network and not network.is_symlink():
            network.symlink_to(gadget / 'functions/ncm.usb0')
        raise
    finally:
        if rebound:
            udc.write_text(controller)


def media_eject(expected):
    with media_locks():
        current = media_status()
        if not current['inserted']:
            return
        if not expected or current['token'] != expected:
            raise ValueError('挂载的磁盘已改变，请刷新后重试')
        try:
            # file_store honors SCSI PREVENT REMOVAL. Never unbind UDC or write
            # forced_eject: both would bypass the host's protection.
            PIKVM_LUN_FILE.write_text('\n')
        except OSError as error:
            if error.errno == errno.EBUSY:
                raise ValueError('被控电脑仍锁定磁盘，请先安全弹出后重试') from error
            raise


def validate_edid(data):
    # Runtime markers store the driver's padded 256-byte slot.
    if len(data) == 256 and data[126] == 0 and data[128:] == bytes(128):
        data = data[:128]
    if (len(data) not in (128, 256) or data[:8] != bytes.fromhex('00ffffffffffff00') or
            data[126] != len(data) // 128 - 1 or
            any(sum(data[i:i + 128]) % 256 for i in range(0, len(data), 128))):
        raise ValueError('EDID 长度、扩展块或校验和无效')
    return data + bytes(256 - len(data))


def edid_catalog():
    presets = json.loads(EDID_CATALOG.read_text())
    if not isinstance(presets, list) or not presets:
        raise ValueError('EDID 预设清单无效')
    ids = set()
    for item in presets:
        if not isinstance(item, dict) or any(not isinstance(item.get(k), str) for k in ('id', 'name', 'description', 'file')):
            raise ValueError('EDID 预设字段无效')
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}', item['id']) or item['id'] in ids:
            raise ValueError('EDID 预设标识无效或重复')
        ids.add(item['id'])
        item['data'] = validate_edid(Path(item['file']).read_bytes())
    if 'VIM4-4K60' not in ids:
        raise ValueError('EDID 清单缺少 VIM4-4K60 默认预设')
    return presets


def saved_edid(presets):
    if (EDID_STATE / 'active.bin').exists():
        return (EDID_STATE / 'active.name').read_text().strip(), validate_edid((EDID_STATE / 'active.bin').read_bytes())
    return 'VIM4-4K60', next(p['data'] for p in presets if p['id'] == 'VIM4-4K60')


def loaded_edid():
    if platform.release().startswith('7.'):
        return validate_edid(Path('/sys/kernel/debug/fe398000.hdmi-receiver/edid').read_bytes())
    if not EDID_LOADED.exists():
        return None
    run = subprocess.run(['systemctl', 'show', '-p', 'InvocationID', '--value', 'tvserver.service'],
                         check=True, capture_output=True, text=True, timeout=10).stdout.strip()
    fields = EDID_LOADED.read_text().split()
    if len(fields) != 2 or not run or fields[0] != run:
        return None
    return validate_edid(bytes.fromhex(fields[1]))


def edid_status():
    presets = edid_catalog()
    name, saved = saved_edid(presets)
    loaded = loaded_edid()
    config = json.loads(JETKVM_CONFIG.read_text()) if JETKVM_CONFIG.exists() else {}
    if not isinstance(config, dict):
        raise ValueError('JetKVM 配置不是 JSON 对象')
    jet_edid = config.get('hdmi_edid_string', '')
    if jet_edid:
        try:
            jet_data = validate_edid(bytes.fromhex(jet_edid))
        except (ValueError, TypeError):
            jet_data = None
    else:
        jet_data = next(p['data'] for p in presets if p['id'] == 'VIM4-4K60')
    return {'presets': [{k: p[k] for k in ('id', 'name', 'description')} for p in presets],
            'selected': next((p['id'] for p in presets if p['data'] == saved), ''),
            'savedName': name,
            'active': next((p['id'] for p in presets if p['data'] == loaded), ''),
            'activeKnown': loaded is not None,
            'jetkvmSynced': jet_data == saved}


def write_jetkvm_config(content):
    # Keep private configuration private, including when JetKVM has not run yet.
    if not JETKVM_CONFIG.parent.exists():
        user = pwd.getpwnam('khadas')
        JETKVM_CONFIG.parent.mkdir(mode=0o700)
        os.chown(JETKVM_CONFIG.parent, user.pw_uid, user.pw_gid)
    owner = JETKVM_CONFIG.stat() if JETKVM_CONFIG.exists() else JETKVM_CONFIG.parent.stat()
    fd, pending = tempfile.mkstemp(prefix='.edid-', dir=JETKVM_CONFIG.parent)
    try:
        with os.fdopen(fd, 'wb') as file:
            os.fchown(file.fileno(), owner.st_uid, owner.st_gid)
            os.fchmod(file.fileno(), 0o600)
            file.write(content)
            file.flush()
            os.fsync(file.fileno())
        os.replace(pending, JETKVM_CONFIG)
    finally:
        if os.path.exists(pending):
            os.unlink(pending)


def load_edid(name, data):
    args = ['preset', name] if name in ('VIM4-4K60', 'VIM4-1080P60', 'VIM4-1080P60-SDR8', 'RTK-1080P120') else ['apply', name]
    subprocess.run([EDID_HELPER, *args], input=data[:128 * (1 + data[126])], check=True, timeout=30)


def select_edid(preset_id):
    presets = edid_catalog()
    preset = next((p for p in presets if p['id'] == preset_id), None)
    if preset is None:
        raise ValueError('未知 EDID 预设')
    old_name, old_saved = saved_edid(presets)
    old_loaded = loaded_edid()
    candidates = list(APPS.values()) if platform.release().startswith('7.') else [APPS['jetkvm']]
    running = [unit for unit in candidates
               if subprocess.run(['systemctl', 'is-active', '--quiet', unit], timeout=10).returncode == 0]
    # Read once before stopping to reject malformed configuration without disruption.
    config = json.loads(JETKVM_CONFIG.read_text()) if JETKVM_CONFIG.exists() else {}
    if not isinstance(config, dict):
        raise ValueError('JetKVM 配置不是 JSON 对象')
    if (old_saved == preset['data'] and old_loaded == preset['data'] and
            str(config.get('hdmi_edid_string', '')).upper() == preset['data'].hex().upper()):
        return
    if running:
        check_pikvm_media(entering=platform.release().startswith('7.'))
        for unit in running:
            systemctl('stop', unit)
    # JetKVM may save settings on shutdown. Snapshot only after it has stopped.
    old_config = None
    config_written = False
    load_attempted = False
    try:
        old_config = JETKVM_CONFIG.read_bytes() if JETKVM_CONFIG.exists() else None
        config = json.loads(old_config) if old_config is not None else {}
        config['hdmi_edid_string'] = preset['data'].hex().upper()
        write_jetkvm_config((json.dumps(config, indent=2) + '\n').encode())
        config_written = True
        if old_saved != preset['data'] or old_loaded != preset['data']:
            load_attempted = True
            load_edid(preset_id, preset['data'])
        for unit in running:
            systemctl('start', unit)
        os.sync()
    except Exception as error:
        recovery = []
        try:
            for unit in running:
                systemctl('stop', unit)
            if config_written:
                if old_config is None:
                    JETKVM_CONFIG.unlink(missing_ok=True)
                else:
                    write_jetkvm_config(old_config)
            if load_attempted:
                load_edid(old_name, old_saved)
            for unit in running:
                systemctl('start', unit)
            os.sync()
        except Exception:
            recovery.append('恢复原配置失败，请检查 HDMI 和 JetKVM 服务')
        raise ValueError('EDID 切换失败；' + ('；'.join(recovery) if recovery else '已恢复原配置')) from error


def media_status():
    lun = PIKVM_LUN_FILE.parent
    image = PIKVM_LUN_FILE.read_text().strip() if lun.exists() else ''
    gadget = lun.parents[2]
    controller = (gadget / 'UDC').read_text().strip() if lun.exists() else ''
    linked = (gadget / 'configs/c.1/mass_storage.disk0').is_symlink()
    configured = controller and (UDC_CLASS / controller / 'state').read_text().strip() == 'configured'
    result = {'known': True, 'inserted': bool(image), 'name': Path(image).name if image else '',
            'token': hashlib.sha256(image.encode()).hexdigest() if image else '',
            'readOnly': (lun / 'ro').read_text().strip() == '1' if image else False,
            'cdrom': (lun / 'cdrom').read_text().strip() == '1' if image else False,
            'connected': bool(image and configured and linked),
            'pikvm': PIKVM_USB_STATE.exists()}
    if image.startswith(str(NASDISK_RUNTIME / 'fs') + '/'):
        session = nasdisk_read('session.json')
        if session and image == str(NASDISK_RUNTIME / 'fs' / ('disk-' + session['id'] + '.img')):
            result['nasdisk'] = {key: session[key] for key in ('storage', 'storageName', 'path', 'mode')}
            result['name'] = 'nas:' + session['storageName'] + '/' + session['path'].lstrip('/')
    return result


def check_pikvm_media(entering=False):
    if (entering or PIKVM_USB_STATE.exists()) and PIKVM_LUN_FILE.exists():
        image = PIKVM_LUN_FILE.read_text().strip()
        if image:
            raise ValueError(f'虚拟磁盘「{Path(image).name}」仍已挂载。请在被控电脑安全弹出后重试；原界面保持运行')


def systemctl(*args):
    subprocess.run(['systemctl', *args], check=True, timeout=60, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})


def installed(unit):
    result = subprocess.run(['systemctl', 'show', '--property=LoadState', '--value', unit],
                            capture_output=True, text=True, timeout=10, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})
    return result.stdout.strip() == 'loaded'


def select(app):
    check_pikvm_media(entering=True)
    unit = APPS[app]
    if not installed(unit):
        raise ValueError(f'{unit} is not installed')
    others = [other for other in APPS.values() if other != unit and installed(other)]
    # Disable first: an interrupted switch must not boot with both enabled.
    if others:
        systemctl('disable', *others)
    systemctl('enable', unit)
    # Conflicts= does not order shutdown before startup. Wait until the old
    # process has released backend port 8081, HID and the encoder before starting.
    if others:
        systemctl('stop', *others)
    systemctl('restart', unit)
    # Enablement links must survive the data=writeback root filesystem.
    os.sync()


def restart(unit):
    if unit not in (*APPS.values(), *PLATFORM):
        raise ValueError('Unit is not managed')
    check_pikvm_media(entering=unit == APPS['pikvm'])
    if unit in APPS.values():
        others = [other for other in APPS.values() if other != unit and installed(other)]
        if others:
            systemctl('stop', *others)
        systemctl('restart', unit)
        return
    # The HDMI service reconfigures capture underneath a running encoder; stop
    # the active application first, then start it again on the new capture.
    active = [app for app in APPS.values() if installed(app) and
              subprocess.run(['systemctl', 'is-active', '--quiet', app], timeout=10).returncode == 0]
    if active:
        systemctl('stop', *active)
    try:
        systemctl('restart', unit)
    finally:
        if active:
            systemctl('start', *active)


def wifi(enabled):
    device = wifi_device()
    if not device:
        raise ValueError('没有可用的 Wi-Fi 设备')
    subprocess.run(['nmcli', 'radio', 'wifi', enabled], check=True, timeout=15, env=WIFI_ENV)
    if enabled == 'on':
        # On VIM4 NetworkManager can report enabled while the primary link is
        # still down. Bring it up so scans can run without a saved connection.
        subprocess.run(['ip', 'link', 'set', 'dev', device, 'up'],
                       check=True, timeout=15, env=WIFI_ENV)


WIFI_ENV = {'LC_ALL': 'C.UTF-8', 'PATH': '/usr/sbin:/usr/bin:/sbin:/bin'}
WIFI_HOTSPOT = 'vim4-hotspot'
WIFI_UUID = re.compile(r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}')


def nmcli(*args, timeout=10):
    # Never forward nmcli stderr: a settings parse error can quote a secret.
    try:
        return subprocess.run(['nmcli', *args], check=True, capture_output=True,
                              text=True, timeout=timeout, env=WIFI_ENV).stdout
    except (OSError, subprocess.SubprocessError):
        raise ValueError('无线网络操作失败，请检查网络、密码和 NetworkManager 状态') from None


def nm_fields(line):
    """Decode nmcli terse fields; both colons and backslashes are escaped."""
    fields, value, escaped = [], '', False
    for char in line:
        if escaped:
            value += char
            escaped = False
        elif char == '\\':
            escaped = True
        elif char == ':':
            fields.append(value)
            value = ''
        else:
            value += char
    fields.append(value + ('\\' if escaped else ''))
    return fields


def nm_values(fields, *args, secret=False):
    output = nmcli(*(['--show-secrets'] if secret else []), '-g', ','.join(fields), *args)
    # Split only NM's record delimiter. str.splitlines also splits valid UTF-8
    # SSIDs containing Unicode line/paragraph separators.
    lines = output[:-1].split('\n') if output.endswith('\n') else output.split('\n')
    values = [nm_fields(line)[0] for line in lines]
    if len(values) != len(fields):
        raise ValueError('无法识别无线网络配置')
    return dict(zip(fields, values))


def wifi_device():
    for line in nmcli('-t', '-f', 'DEVICE,TYPE', 'device').split('\n'):
        if not line:
            continue
        device, kind = nm_fields(line)
        if kind == 'wifi':
            return device
    return ''


def wifi_device_info(device, timeout=10):
    info = {}
    for line in nmcli('-t', '-f', 'GENERAL.STATE,GENERAL.CON-UUID,GENERAL.HWADDR,IP4.ADDRESS,IP6.ADDRESS',
                      'device', 'show', device, timeout=timeout).split('\n'):
        if not line:
            continue
        # device show leaves colons in values (MAC, IPv6) unescaped.
        key, _, value = line.partition(':')
        info[key] = value
    return info


def wifi_profiles():
    profiles = []
    for line in nmcli('-t', '-f', 'UUID,TYPE,NAME', 'connection', 'show').split('\n'):
        if not line:
            continue
        identifier, kind, name = nm_fields(line)
        if kind not in ('wifi', '802-11-wireless'):
            continue
        fields = ('802-11-wireless.ssid', '802-11-wireless.mode',
                  'connection.autoconnect', '802-11-wireless.channel')
        values = nm_values(fields, 'connection', 'show', 'uuid', identifier)
        profiles.append({'id': identifier, 'name': name, 'ssid': values[fields[0]],
                         'mode': values[fields[1]], 'autoconnect': values[fields[2]] == 'yes',
                         'channel': int(values[fields[3]] or 0)})
    return profiles


def wifi_context(device=None):
    device = device or wifi_device()
    if not device:
        raise ValueError('没有可用的 Wi-Fi 设备')
    radio = nm_fields(nmcli('-t', '-f', 'WIFI-HW,WIFI', 'general').strip())
    if len(radio) != 2 or any(value not in ('enabled', 'disabled') for value in radio):
        raise ValueError('无法识别 Wi-Fi 开关状态')
    return device, radio, wifi_device_info(device), wifi_profiles()


def wifi_hotspot_profile(profiles):
    return next((p for p in profiles if p['name'] == WIFI_HOTSPOT and p['mode'] == 'ap'), None)


def wifi_client_profiles(profiles):
    return [p for p in profiles if p['name'] != WIFI_HOTSPOT and p['mode'] in ('', 'infrastructure')]


def wifi_default_ssid(info):
    suffix = info.get('GENERAL.HWADDR', '').replace(':', '')[-4:].upper()
    return 'VIM4-KVM-' + suffix


def wifi_stations(device):
    try:
        result = subprocess.run(['iw', 'dev', device, 'station', 'dump'], check=True,
                                capture_output=True, text=True, timeout=5, env=WIFI_ENV)
    except (OSError, subprocess.SubprocessError):
        return []
    stations = {mac.lower(): {'mac': mac.lower(), 'ip': '', 'hostname': ''}
                for mac in re.findall(r'^Station ([0-9a-fA-F:]{17})\b', result.stdout, re.M)}
    try:
        leases = Path(f'/var/lib/NetworkManager/dnsmasq-{device}.leases').read_text()
    except OSError:
        leases = ''
    for line in leases.splitlines():
        parts = line.split()
        if len(parts) < 4 or not parts[0].isdigit():
            continue
        expiry, mac, address, hostname = parts[:4]
        if mac.lower() in stations and (int(expiry) == 0 or int(expiry) > time.time()):
            stations[mac.lower()].update(ip=address, hostname='' if hostname == '*' else hostname)
    return list(stations.values())


def wifi_access_points(device, profiles, rescan):
    networks = []
    saved = {p['ssid'] for p in wifi_client_profiles(profiles)}
    output = nmcli('--wait', '10', '-t', '-f', 'SSID,SIGNAL,SECURITY,FREQ,IN-USE',
                   'device', 'wifi', 'list', 'ifname', device, '--rescan',
                   'yes' if rescan else 'no', timeout=12)
    for line in output.split('\n'):
        if not line:
            continue
        ssid, signal, security, frequency, active = nm_fields(line)
        if not ssid:
            continue
        network = {'ssid': ssid, 'signal': int(signal or 0), 'security': '' if security == '--' else security,
                   # NM 1.46 keeps the MHz suffix even in terse output.
                   'frequency': int(frequency.split()[0]) if frequency else 0,
                   'saved': ssid in saved, 'active': active == '*'}
        networks.append(network)
    return networks


def wifi_networks(device, profiles, rescan):
    strongest = {}
    for network in wifi_access_points(device, profiles, rescan):
        previous = strongest.get(network['ssid'])
        active = network['active'] or bool(previous and previous['active'])
        if previous is None or network['signal'] > previous['signal']:
            strongest[network['ssid']] = network
        strongest[network['ssid']]['active'] = active
    return sorted(strongest.values(), key=lambda n: (-n['signal'], n['ssid']))


def wifi_status():
    state = {'supported': False, 'enabled': False, 'hardwareEnabled': False, 'device': '',
             'mode': '', 'state': '', 'current': None, 'saved': [],
             'hotspot': {'configured': False, 'active': False, 'ssid': '', 'password': '',
                         'channel': 0, 'autostart': False, 'address': '', 'clients': []}}
    device = wifi_device()
    if not device:
        return state
    device, radio, info, profiles = wifi_context(device)
    active = info.get('GENERAL.CON-UUID', '')
    hotspot = wifi_hotspot_profile(profiles)
    enabled, hardware = radio[1] == 'enabled', radio[0] == 'enabled'
    mode = 'off' if not enabled or not hardware else 'hotspot' if hotspot and active == hotspot['id'] else 'client'
    code = int(info.get('GENERAL.STATE', '0').split()[0])
    status = ('connected' if code == 100 else 'connecting' if 40 <= code <= 90 else
              'disconnected' if code in (30, 110, 120) else 'unavailable')
    state.update(supported=True, enabled=enabled, hardwareEnabled=hardware, device=device, mode=mode, state=status)
    state['saved'] = [{'id': p['id'], 'ssid': p['ssid'], 'autoconnect': p['autoconnect'], 'active': p['id'] == active}
                      for p in wifi_client_profiles(profiles)]
    state['hotspot'].update(ssid=wifi_default_ssid(info), address='10.42.0.1/24')
    if hotspot:
        password = nm_values(('802-11-wireless-security.psk',), 'connection', 'show', 'uuid',
                             hotspot['id'], secret=True)['802-11-wireless-security.psk']
        state['hotspot'].update(configured=True, active=mode == 'hotspot', ssid=hotspot['ssid'],
                                password=password, channel=hotspot['channel'], autostart=hotspot['autoconnect'])
    addresses = [value for key, value in info.items() if key.startswith('IP4.ADDRESS')]
    if mode == 'hotspot':
        state['hotspot'].update(address=next(iter(addresses), '10.42.0.1/24'), clients=wifi_stations(device))
    elif mode == 'client':
        current = next((p for p in wifi_client_profiles(profiles) if p['id'] == active), None)
        if current:
            # Status reads cached AP data; they never initiate a scan.
            networks = wifi_access_points(device, profiles, False)
            ap = next((n for n in networks if n['active']), {})
            state['current'] = {'id': active, 'ssid': current['ssid'], 'signal': ap.get('signal', 0),
                                'security': ap.get('security', ''), 'frequency': ap.get('frequency', 0),
                                'ipv4': next(iter(addresses), '')}
    return state


def wifi_validate_ssid(ssid):
    if (not isinstance(ssid, str) or not 1 <= len(ssid.encode('utf-8')) <= 32 or
            any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in ssid)):
        raise ValueError('SSID 必须为 1–32 字节 UTF-8，且不能包含控制字符')


def wifi_validate_password(password, hotspot=False):
    if not isinstance(password, str):
        raise ValueError('密码格式错误')
    if password == '' or (8 <= len(password) <= 63 and all(32 <= ord(c) <= 126 for c in password)):
        return
    if not hotspot and re.fullmatch(r'[0-9a-fA-F]{64}', password):
        return
    raise ValueError('密码必须为 8–63 位可打印 ASCII 字符' + ('' if hotspot else '，或 64 位十六进制'))


def wifi_read_request(hotspot=False):
    try:
        raw = sys.stdin.read(4097)
        if len(raw) > 4096:
            raise ValueError('无线网络请求过大')
        data = json.loads(raw)
        if not isinstance(data, dict):
            raise ValueError('无线网络请求格式错误')
        wifi_validate_ssid(data.get('ssid'))
        wifi_validate_password(data.get('password', ''), hotspot)
        if hotspot:
            if type(data.get('channel')) is not int or not 0 <= data['channel'] <= 11:
                raise ValueError('热点信道必须为 0–11')
            if type(data.get('autostart')) is not bool:
                raise ValueError('需要 autostart 布尔值')
        elif type(data.get('hidden', False)) is not bool:
            raise ValueError('需要 hidden 布尔值')
        return data
    except (TypeError, UnicodeError, json.JSONDecodeError):
        raise ValueError('无线网络请求格式错误') from None


def wifi_saved(identifier, profiles):
    if not WIFI_UUID.fullmatch(identifier):
        raise ValueError('无线连接 UUID 格式错误')
    profile = next((p for p in wifi_client_profiles(profiles) if p['id'].lower() == identifier.lower()), None)
    if not profile:
        raise ValueError('找不到已保存的无线连接')
    return profile


def wifi_dbus(action, identifier=None, settings=None):
    # Let NM's settings plugin persist changes (on VIM4 this is netplan).
    # Secrets travel over D-Bus, never through argv or nmcli's editor parser.
    try:
        import dbus
    except ImportError:
        raise ValueError('无线网络配置需要 python3-dbus') from None
    # dbus-python logs rejected arguments, PSK included, to stderr.
    logging.getLogger('dbus').disabled = True
    logging.getLogger('dbus.connection').disabled = True
    try:
        bus = dbus.SystemBus()
        service = 'org.freedesktop.NetworkManager'
        manager = dbus.Interface(bus.get_object(service, '/org/freedesktop/NetworkManager/Settings'),
                                 service + '.Settings')
        connection = None
        if identifier:
            connection = dbus.Interface(bus.get_object(service, manager.GetConnectionByUuid(identifier)),
                                        service + '.Settings.Connection')
        if action == 'read':
            config = connection.GetSettings()
            # GetSettings omits secrets. Include them in snapshots so Update
            # and rollback cannot silently discard the existing credentials.
            for section in ('802-11-wireless-security', '802-1x'):
                if section in config:
                    for name, values in connection.GetSecrets(section).items():
                        config.setdefault(name, {}).update(values)
            return config
        config = {name: dict(values) for name, values in settings.items()}
        wireless = config.get('802-11-wireless', {})
        if 'ssid' in wireless:
            wireless['ssid'] = dbus.ByteArray(wireless['ssid'])
        if 'channel' in wireless:
            wireless['channel'] = dbus.UInt32(wireless['channel'])
        security = config.get('802-11-wireless-security', {})
        if 'psk-flags' in security:
            security['psk-flags'] = dbus.UInt32(security['psk-flags'])
        for name in ('proto', 'pairwise'):
            if name in security:
                security[name] = dbus.Array(security[name], signature='s')
        connection_settings = config.get('connection', {})
        if 'autoconnect-priority' in connection_settings:
            connection_settings['autoconnect-priority'] = dbus.Int32(connection_settings['autoconnect-priority'])
        config = dbus.Dictionary({name: dbus.Dictionary(values, signature='sv')
                                  for name, values in config.items()}, signature='sa{sv}')
        if action == 'update':
            connection.Update(config)
        elif action == 'add':
            manager.AddConnection(config)
        else:
            raise ValueError('未知无线配置操作')
    except dbus.DBusException:
        # D-Bus errors may quote settings, including the PSK.
        raise ValueError('无线网络配置失败，请检查 NetworkManager 状态') from None


def wifi_key_management(device, ssid, existing=None):
    networks = [n for n in wifi_access_points(device, [], False) if n['ssid'] == ssid]
    # A mixed-mode AP remains usable by drivers without SAE. Only WPA3-only
    # personal networks require SAE; do not let NM scan until its timeout.
    sae_only = bool(networks) and all('WPA3' in n['security'] and
                                    not any(v in n['security'].split() for v in ('WPA1', 'WPA2'))
                                    for n in networks)
    if not networks and existing:
        settings = wifi_dbus('read', existing['id'])
        sae_only = settings.get('802-11-wireless-security', {}).get('key-mgmt') == 'sae'
    if not sae_only:
        return 'wpa-psk'
    try:
        capabilities = subprocess.check_output(
            ['wpa_cli', '-i', device, 'get_capability', 'key_mgmt'],
            text=True, stderr=subprocess.DEVNULL, timeout=3, env=WIFI_ENV)
    except (OSError, subprocess.SubprocessError):
        raise ValueError('无法确认 WPA3 支持，原无线连接未改动') from None
    if 'SAE' not in capabilities.split():
        raise ValueError('该网络仅支持 WPA3，当前无线驱动未提供 SAE；请使用 WPA2/WPA3 混合模式或 WPA2 网络。原无线连接未改动')
    return 'sae'


def wifi_profile_config(device, data, existing=None, hotspot=False):
    key_management = 'wpa-psk' if hotspot or not data.get('password') else wifi_key_management(device, data['ssid'], existing)
    if existing:
        previous = wifi_dbus('read', existing['id'])
        # Copy sections only: deepcopy drops the D-Bus signature of empty
        # arrays, and NM then rejects the whole Update.
        config = {name: dict(values) for name, values in previous.items()}
    else:
        previous = None
        identifier = str(uuid.uuid4())
        config = {}
        # A client SSID may equal our reserved AP connection name.
        name = WIFI_HOTSPOT if hotspot else data['ssid']
        if not hotspot and name == WIFI_HOTSPOT:
            name = 'vim4-client-' + identifier
        config['connection'] = {'id': name, 'uuid': identifier,
                                'type': '802-11-wireless', 'autoconnect': False}
    config['connection']['interface-name'] = device
    wireless = config.setdefault('802-11-wireless', {})
    wireless.update({'ssid': data['ssid'].encode('utf-8'),
                     'mode': 'ap' if hotspot else 'infrastructure'})
    if hotspot:
        config['connection'].update({'autoconnect': data['autostart'], 'autoconnect-priority': 100})
        wireless.update({'band': 'bg', 'channel': data['channel']})
        config.setdefault('ipv4', {})['method'] = 'shared'
        config.setdefault('ipv6', {})['method'] = 'disabled'
    else:
        wireless['hidden'] = data.get('hidden', False)
        if not existing:
            config['ipv4'] = {'method': 'auto'}
            config['ipv6'] = {'method': 'auto'}
    if data.get('password'):
        security = config.setdefault('802-11-wireless-security', {})
        security.update({'key-mgmt': key_management, 'psk': data['password'], 'psk-flags': 0})
        if key_management == 'sae':
            security['pmf'] = 3  # NM_SETTING_WIRELESS_SECURITY_PMF_REQUIRED
        if hotspot:
            security.update({'proto': ['rsn'], 'pairwise': ['ccmp']})
    elif not hotspot and 'password' in data:
        config.pop('802-11-wireless-security', None)
        config.pop('802-1x', None)
    return config, previous, config['connection']['uuid']


def wifi_disconnect(device):
    # nmcli fails on an already inactive device, which would abort recovery.
    state = wifi_device_info(device).get('GENERAL.STATE', '')
    if state.split(' ', 1)[0] in ('10', '20', '30'):
        return
    nmcli('device', 'disconnect', device)


def wifi_up(identifier, device, wait=45):
    nmcli('--wait', str(wait), 'connection', 'up', 'uuid', identifier, 'ifname', device, timeout=wait + 2)


def wifi_restore(active, device):
    if active and active != '--':
        wifi_up(active, device, 30)
    else:
        wifi_disconnect(device)


def wifi_apply_profile(device, data, existing, active, hotspot=False):
    config, previous, identifier = wifi_profile_config(device, data, existing, hotspot)
    try:
        wifi_dbus('update' if existing else 'add', identifier if existing else None, config)
        wifi_up(identifier, device)
        if not hotspot and not existing:
            nmcli('connection', 'modify', 'uuid', identifier, 'connection.autoconnect', 'yes')
    except (ValueError, OSError):
        # Always cancel a timed-out activation before recovery. Existing saved
        # profiles keep their UUID, settings and old password after failure.
        recovery_failed = False
        for recover in (
                lambda: wifi_disconnect(device),
                (lambda: wifi_dbus('update', identifier, previous)) if existing else
                (lambda: nmcli('connection', 'delete', 'uuid', identifier)),
                lambda: wifi_restore(active, device)):
            try:
                recover()
            except (ValueError, OSError):
                recovery_failed = True
        raise ValueError('无线连接失败，' + ('恢复原连接失败，请通过有线网络检查' if recovery_failed else '已恢复原连接')) from None
    return identifier


def wifi_configure_hotspot(device, info, profiles, data=None):
    existing = wifi_hotspot_profile(profiles)
    if data is None:
        data = {'ssid': existing['ssid'] if existing else wifi_default_ssid(info), 'password': '',
                'channel': existing['channel'] if existing else 0,
                'autostart': existing['autoconnect'] if existing else False}
    data = dict(data)
    if not data.get('password') and existing:
        data['password'] = nm_values(('802-11-wireless-security.psk',), 'connection', 'show', 'uuid',
                                     existing['id'], secret=True)['802-11-wireless-security.psk']
    if not data.get('password'):
        data['password'] = ''.join(secrets.choice('ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789') for _ in range(12))
    wifi_validate_password(data['password'], hotspot=True)
    if existing and existing['id'] == info.get('GENERAL.CON-UUID'):
        return wifi_apply_profile(device, data, existing, existing['id'], hotspot=True)
    config, previous, identifier = wifi_profile_config(device, data, existing, hotspot=True)
    try:
        wifi_dbus('update' if existing else 'add', identifier if existing else None, config)
    except (ValueError, OSError):
        if existing:
            wifi_dbus('update', identifier, previous)
        raise
    return identifier


def wifi_disable_hotspot_autostart(hotspot):
    if hotspot:
        nmcli('connection', 'modify', 'uuid', hotspot['id'], 'connection.autoconnect', 'no')


def wifi_change_mode(mode, force, device, info, profiles):
    hotspot = wifi_hotspot_profile(profiles)
    active = info.get('GENERAL.CON-UUID', '')
    if mode == 'hotspot':
        identifier = wifi_configure_hotspot(device, info, profiles)
        if active == identifier:
            return
        try:
            wifi_up(identifier, device)
        except ValueError:
            try:
                wifi_disconnect(device)
                wifi_restore(active, device)
            except ValueError:
                raise ValueError('热点启动失败，恢复原连接失败，请通过有线网络检查') from None
            raise ValueError('热点启动失败，已恢复原连接') from None
        return
    wifi_disable_hotspot_autostart(hotspot)
    if not hotspot or active != hotspot['id']:
        return
    if force:
        wifi_disconnect(device)
        nmcli('device', 'set', device, 'autoconnect', 'yes')
        return
    try:
        wifi_disconnect(device)
        deadline = time.monotonic() + 30
        if not wifi_client_profiles(profiles):
            raise ValueError('没有已保存的无线连接')
        # Re-enable device autoconnection after device disconnect. Let NM try
        # eligible saved networks; device up could create an unwanted profile.
        nmcli('device', 'set', device, 'autoconnect', 'yes')
        clients = {p['id'] for p in wifi_client_profiles(profiles)}
        while (remaining := deadline - time.monotonic()) > 0:
            current = wifi_device_info(device, timeout=min(3, remaining))
            if current.get('GENERAL.CON-UUID') in clients and current.get('GENERAL.STATE', '').startswith('100 '):
                return
            time.sleep(min(0.5, remaining))
        raise ValueError('30 秒内未连接到已保存网络')
    except ValueError as error:
        reason = str(error)
        try:
            wifi_disconnect(device)
            wifi_up(hotspot['id'], device, 30)
            if hotspot['autoconnect']:
                nmcli('connection', 'modify', 'uuid', hotspot['id'], 'connection.autoconnect', 'yes')
        except ValueError:
            raise ValueError('客户端连接失败，恢复热点失败，请通过有线网络检查') from None
        raise ValueError(reason + '，已恢复热点') from None


def wifi_command(argv):
    if argv == ['wifi-status']:
        return wifi_status()
    data = None
    match argv:
        case ['wifi-scan', rescan] if rescan in ('0', '1'):
            pass
        case ['wifi-connect'] | ['wifi-hotspot']:
            data = wifi_read_request(argv[0] == 'wifi-hotspot')
        case ['wifi-activate', identifier] | ['wifi-forget', identifier]:
            if not WIFI_UUID.fullmatch(identifier):
                raise ValueError('无线连接 UUID 格式错误')
        case ['wifi-autoconnect', identifier, enabled] if enabled in ('yes', 'no'):
            if not WIFI_UUID.fullmatch(identifier):
                raise ValueError('无线连接 UUID 格式错误')
        case ['wifi-disconnect']:
            pass
        case ['wifi-mode', mode] | ['wifi-mode', mode, 'force'] if mode in ('client', 'hotspot'):
            pass
        case _:
            raise ValueError('无线网络操作参数错误')
    if argv[0] == 'wifi-scan' and not wifi_device():
        return {'networks': []}
    device, radio, info, profiles = wifi_context()
    active = info.get('GENERAL.CON-UUID', '')
    hotspot = wifi_hotspot_profile(profiles)
    action = argv[0]
    if action == 'wifi-scan':
        return {'networks': [] if radio != ['enabled', 'enabled'] or hotspot and active == hotspot['id'] else
                wifi_networks(device, profiles, argv[1] == '1')}
    if action in ('wifi-connect', 'wifi-activate', 'wifi-mode') and radio != ['enabled', 'enabled']:
        raise ValueError('请先开启 Wi-Fi 并解除硬件禁用')
    if action == 'wifi-connect':
        existing = next((p for p in wifi_client_profiles(profiles) if p['ssid'] == data['ssid']), None)
        wifi_apply_profile(device, data, existing, active)
        wifi_disable_hotspot_autostart(hotspot)
    elif action == 'wifi-hotspot':
        wifi_configure_hotspot(device, info, profiles, data)
    elif action == 'wifi-mode':
        wifi_change_mode(argv[1], len(argv) == 3, device, info, profiles)
    elif action == 'wifi-disconnect':
        if hotspot and active == hotspot['id']:
            raise ValueError('请通过模式切换停止热点')
        wifi_disconnect(device)
    else:
        profile = wifi_saved(argv[1], profiles)
        identifier = profile['id']
        if action == 'wifi-autoconnect':
            nmcli('connection', 'modify', 'uuid', identifier, 'connection.autoconnect', argv[2])
        elif action == 'wifi-forget':
            if active == identifier:
                wifi_disconnect(device)
            nmcli('connection', 'delete', 'uuid', identifier)
        elif action == 'wifi-activate':
            try:
                wifi_up(identifier, device)
            except ValueError:
                try:
                    wifi_disconnect(device)
                    wifi_restore(active, device)
                except ValueError:
                    raise ValueError('无线连接失败，恢复原连接失败，请通过有线网络检查') from None
                raise ValueError('无线连接失败，已恢复原连接') from None
            wifi_disable_hotspot_autostart(hotspot)
    return {'ok': True}


def nits(text, low, high):
    if not (text.isascii() and text.isdigit()) or not low <= int(text) <= high:
        raise ValueError(f'{text!r} must be {low}-{high} nits')
    return int(text)


def write_config(path, content):
    pending = path + '.pending'
    with open(pending, 'wb') as file:
        file.write(content)
        os.fchmod(file.fileno(), 0o644)
        os.fsync(file.fileno())
    os.replace(pending, path)
    os.sync()


def apply_hdr_curve(white, peak):
    """Load the curve into the running capture; it takes effect next frame."""
    white = nits(white, 160, 1000)
    peak = nits(peak, white + 1, 10000)
    subprocess.run([HDR_CURVE, 'apply', str(white), str(peak)], check=True, timeout=10,
                   env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})
    return white, peak


def hdr_curve(white, peak):
    """Apply the curve now and keep it for the next HDMI service start."""
    white, peak = apply_hdr_curve(white, peak)
    write_config(HDR_CONFIG, f'HDR_SDR_WHITE={white}\nHDR_SDR_PEAK={peak}\n'.encode())


def celsius(text, low, high):
    if not (text.isascii() and text.isdigit()) or not low <= int(text) <= high:
        raise ValueError(f'{text!r} must be {low}-{high} °C')
    return int(text)


def fan_triggers(low, mid, high):
    # Limits match internal/board/fan.go. The driver starts the fan 15 °C
    # below low; the SoC passive trip point is 95 °C.
    low = celsius(low, 35, 80)
    mid = celsius(mid, low + 5, 95)
    high = celsius(high, mid + 5, 100)
    return low, mid, high


def write_fan_triggers(low, mid, high):
    """Apply in an order the driver accepts from any valid starting curve."""
    if platform.release().startswith('7.'):
        path = MAINLINE_FAN / 'trigger_temperatures'
        target = f'{low} {mid} {high}'
        if path.read_text().strip() != target:
            path.write_text(target + '\n')
        return
    def current(name):
        return int((FAN_SYSFS / name).read_text().rsplit(':', 1)[1])

    # Every accepted write also advances the fan one ramp step; skip no-ops.
    def store(name, value):
        if current(name) != value:
            (FAN_SYSFS / name).write_text(f'{value}\n')

    # The driver requires low < mid < high after every write. Widen the
    # bounds first so the new middle value always fits, then narrow them.
    store('trigger_temp_high', max(high, current('trigger_temp_high')))
    store('trigger_temp_low', min(low, current('trigger_temp_low')))
    store('trigger_temp_mid', mid)
    store('trigger_temp_low', low)
    store('trigger_temp_high', high)
    # The curve only drives the fan in automatic mode.
    store('mode', 1)


def fan_curve(low, mid, high):
    triggers = fan_triggers(low, mid, high)
    write_fan_triggers(*triggers)
    write_config(FAN_CONFIG, ''.join(f'{k}={v}\n' for k, v in zip(FAN_KEYS, triggers)).encode())


def fan_restore():
    if not os.path.exists(FAN_CONFIG):
        return
    values = {}
    for line in Path(FAN_CONFIG).read_text().splitlines():
        key, _, value = line.partition('=')
        values[key.strip()] = value.strip()
    if any(key not in values for key in FAN_KEYS):
        raise ValueError(f'{FAN_CONFIG} is incomplete')
    write_fan_triggers(*fan_triggers(*(values[key] for key in FAN_KEYS)))


def update_run(*args):
    return subprocess.check_output(args, text=True, stderr=subprocess.STDOUT, timeout=600,
                                   env={'LC_ALL': 'C', 'PATH': '/usr/sbin:/usr/bin:/sbin:/bin'}).strip()


def open_download(package):
    # Open below the download directory without following links, so the
    # unprivileged downloader cannot point the helper at another file.
    directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in UPDATE_DOWNLOADS.parts[1:]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = child
        fd = os.open(f'{package}.deb', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    finally:
        os.close(directory)
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or not 0 < info.st_size <= UPDATE_LIMIT:
        os.close(fd)
        raise ValueError('Invalid update package type or size')
    return os.fdopen(fd, 'rb')


def update(package, checksum, version):
    if package not in UPDATES:
        raise ValueError('Package is not updated by the manager')
    if not re.fullmatch(r'[0-9a-f]{64}', checksum):
        raise ValueError('Invalid SHA256')
    if not re.fullmatch(r'\d+\.\d+\.\d+\+vim4\.\d{8}\.\d+', version):
        raise ValueError('Expected a VIM4 Ubuntu package version')
    UPDATE_STAGING.mkdir(mode=0o700, exist_ok=True)
    # The caller cannot replace this snapshot after validation.
    with tempfile.TemporaryDirectory(dir=UPDATE_STAGING) as directory:
        deb = Path(directory) / 'update.deb'
        with open_download(package) as incoming, deb.open('wb') as output:
            shutil.copyfileobj(incoming, output)
        with deb.open('rb') as stream:
            if hashlib.file_digest(stream, 'sha256').hexdigest() != checksum:
                raise ValueError('Package SHA256 mismatch')
        for field, expected in (('Package', package), ('Architecture', 'arm64'), ('Version', version)):
            if update_run('dpkg-deb', '-f', str(deb), field) != expected:
                raise ValueError('Package metadata does not match the requested update')
        current = subprocess.run(['dpkg-query', '-W', '-f=${Version}', package], capture_output=True, text=True,
                                 timeout=30, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'}).stdout.strip()
        if not current:
            raise ValueError(f'{package} is not installed; deploy it with the component packages')
        if subprocess.run(['dpkg', '--compare-versions', version, 'gt', current], timeout=30).returncode:
            raise ValueError('Update is not newer than the installed version')
        # Never let a web update pull platform upgrades or remove packages.
        for line in update_run('apt-get', '--simulate', '--no-remove', 'install', str(deb)).splitlines():
            if line.startswith('Remv ') or (line.startswith('Inst ') and line.split()[1] != package):
                raise ValueError('Deploy the platform components before this update')
        if package == 'vim4-pikvm':
            check_pikvm_media(entering=True)
        update_run('dpkg', '--force-confdef', '--force-confold', '-i', str(deb))
        for line in update_run('dpkg', '--verify', package).splitlines():
            # --force-confold preserves administrator-owned PiKVM settings.
            # Missing files, executables and sudoers must still verify exactly.
            if package == 'vim4-pikvm' and re.fullmatch(r'\?\?5\?{6} c /etc/kvmd/.+', line):
                continue
            raise ValueError('Installed package verification failed')
        os.sync()
    unit = UPDATES[package]
    if subprocess.run(['systemctl', 'is-active', '--quiet', unit], timeout=10).returncode == 0:
        # Restarting the manager ends this request; let the caller answer first.
        subprocess.run(['systemd-run', '--on-active=3', '/usr/bin/systemctl', 'restart', unit],
                       check=True, timeout=30, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})


NAS_CONFIG = Path('/etc/vim4-kvm/nas')
NAS_ROOT = Path('/var/lib/vim4-kvm/nas')
NAS_RUNTIME = Path('/run/vim4-manager-nas')
NAS_TEST = Path('/run/vim4-manager-nas-test')
NAS_UNITS = Path('/etc/systemd/system')
NAS_VERSIONS = {'smb': ('auto', '3.1.1', '3.0', '2.1', '2.0', '1.0'),
                'nfs': ('auto', '4.2', '4.1', '4.0', '3')}


def storage_id(value):
    if not isinstance(value, str) or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,31}', value):
        raise ValueError('网络存储 ID 无效')
    return value


def storage_validate(data, testing=False):
    if not isinstance(data, dict):
        raise ValueError('网络存储参数必须为 JSON 对象')
    kind = data.get('type')
    if not isinstance(kind, str) or kind not in NAS_VERSIONS:
        raise ValueError('网络存储类型必须为 smb 或 nfs')
    result = {}
    for key in ('id', 'name', 'server', 'share', 'domain', 'username', 'version'):
        value = data.get(key, 'auto' if key == 'version' else '')
        if not isinstance(value, str) or len(value) > 1024:
            raise ValueError('网络存储字段无效：' + key)
        result[key] = value
    if result['id']:
        storage_id(result['id'])
    if (not testing and not result['name']) or len(result['name']) > 80 or any(ord(c) < 32 or ord(c) == 127 for c in result['name']):
        raise ValueError('名称需为 1–80 个可显示字符')
    server = result['server']
    try:
        ipaddress.ip_address(server)
        if '%' in server:
            raise ValueError()
    except ValueError:
        if len(server) > 253 or not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?', server) or any(
                not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', label) for label in server.split('.')):
            raise ValueError('服务器必须为主机名、IPv4 或 IPv6 地址') from None
    share = result['share']
    if share.startswith('/') != (kind == 'nfs'):
        raise ValueError('SMB 使用共享名；NFS 使用以 / 开头的导出路径')
    # NAS shares are often named in Chinese or with spaces. The value lands in a
    # unit's What= (systemd expands % and trims outer blanks) and a mount argument.
    segments = share[1:].split('/') if kind == 'nfs' else share.split('/')
    if share != '/' and (any(not part or part in ('.', '..') or part != part.strip() for part in segments) or
                         re.search(r'[\x00-\x1f\x7f\\"*?<>|:%]', share)):
        raise ValueError('共享路径包含不支持的字符或路径段')
    for key in ('domain', 'username'):
        value = result[key]
        if value != value.strip() or re.search(r'[\x00-\x1f\x7f\\/"\[\]:;|=,+*?<>%]', value) or value in ('.', '..'):
            raise ValueError('用户名或域包含不支持的字符')
    if result['version'] not in NAS_VERSIONS[kind]:
        raise ValueError('协议版本不支持')
    if type(data.get('autoMount', False)) is not bool:
        raise ValueError('autoMount 必须为布尔值')
    if 'password' in data and (not isinstance(data['password'], str) or len(data['password']) > 4096 or
                               any(c in data['password'] for c in '\r\n\0')):
        raise ValueError('密码不能包含换行或 NUL，最长 4096 字符')
    result.update(type=kind, autoMount=data.get('autoMount', False))
    return result


def storage_read_request():
    try:
        raw = sys.stdin.read(16385)
        if len(raw) > 16384:
            raise ValueError()
        data = json.loads(raw)
        if not isinstance(data, dict):
            raise ValueError()
        return data
    except (ValueError, UnicodeError):
        raise ValueError('网络存储 JSON 参数无效') from None


def storage_atomic(path, content, mode):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            os.fchmod(output.fileno(), mode)
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def storage_load(identifier):
    identifier = storage_id(identifier)
    try:
        data = storage_validate(json.loads((NAS_CONFIG / (identifier + '.json')).read_text()))
    except FileNotFoundError:
        raise ValueError('网络存储不存在') from None
    if data['id'] != identifier:
        raise ValueError('网络存储配置 ID 不匹配')
    return data


def storage_credentials(config, request):
    if config['type'] != 'smb' or not config['username']:
        return None
    password = request.get('password')
    if password is None:
        try:
            saved = (NAS_CONFIG / (storage_id(config['id']) + '.cred')).read_text()
            password = next(line[len('password='):] for line in saved.split('\n') if line.startswith('password='))
        except (ValueError, FileNotFoundError, StopIteration):
            raise ValueError('SMB 首次保存或测试需要密码（可为空）') from None
    return f"username={config['username']}\npassword={password}\ndomain={config['domain']}\n"


def storage_source(config):
    server = config['server']
    if ':' in server:
        server = '[' + server + ']'
    return '//' + server + '/' + config['share'] if config['type'] == 'smb' else server + ':' + config['share']


def storage_options(config, credentials, unit=True):
    if config['type'] == 'smb':
        login = f'credentials={credentials}' if config['username'] else 'guest'
        options = (f'{login},uid=khadas,gid=khadas,forceuid,forcegid,'
                   'file_mode=0660,dir_mode=0770,soft,echo_interval=10,serverino,iocharset=utf8')
        version_key = 'vers'
    else:
        options, version_key = 'soft,timeo=150,retrans=3', 'nfsvers'
    if unit:
        # nofail makes a direct mount exit 0 on failure, hiding the reason from tests.
        options += ',nofail,_netdev,x-systemd.mount-timeout=30'
    if config['version'] != 'auto':
        options += ',' + version_key + '=' + config['version']
    return options


def storage_error(error):
    # Never relay command output: mount helpers can echo credentials or user input.
    text = str(error).lower()
    for terms, message in ((('permission', 'access denied', 'errno 13', 'error(13)'), '权限被拒'),
                           (('unreachable', 'no route', 'resolve', 'host is down', 'could not connect', 'connection refused',
                             'errno 113', 'error(113)', 'error(112)', 'error(111)'), '主机不可达'),
                           (('no such file', 'not found', 'errno 2', 'error(2)'), '共享不存在'),
                           (('protocol', 'not supported', 'errno 95', 'error(95)'), '协议版本不匹配'),
                           (('timeout', 'timed out', '超时'), '超时')):
        if any(term in text for term in terms):
            return message
    return '网络存储操作失败，请检查服务器、共享和凭据'


def storage_run(args, timeout=35):
    process = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True,
                               env={'LC_ALL': 'C', 'PATH': '/usr/sbin:/usr/bin:/sbin:/bin'})
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except BaseException as error:
        # mount invokes mount.cifs/mount.nfs: terminate the entire helper group.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        # A mount syscall can stay in D state after SIGKILL; never wait indefinitely.
        try:
            process.communicate(timeout=0.1)
        except subprocess.TimeoutExpired:
            process.stdout.close()
            process.stderr.close()
        if isinstance(error, subprocess.TimeoutExpired):
            raise ValueError('网络存储操作超时') from None
        raise
    if process.returncode:
        raise ValueError(storage_error(stderr))
    return stdout.strip()


def storage_unit_name(identifier):
    return storage_run(['systemd-escape', '--path', '--suffix=mount', str(NAS_ROOT / storage_id(identifier))], 2)


def storage_unit(config):
    identifier = config['id']
    return ('[Unit]\nDescription=VIM4 NAS ' + identifier + '\nWants=network-online.target\nAfter=network-online.target\n'
            '\n[Mount]\nWhat=' + storage_source(config) + '\nWhere=' + str(NAS_ROOT / identifier) +
            '\nType=' + ('cifs' if config['type'] == 'smb' else 'nfs') + '\nOptions=' +
            storage_options(config, NAS_CONFIG / (identifier + '.cred')) +
            '\nTimeoutSec=30\n\n[Install]\nWantedBy=remote-fs.target\n')


def storage_mounted(path):
    # Directory existence is never evidence of a mount, including after failed starts.
    for line in Path('/proc/self/mountinfo').read_text().splitlines():
        fields = line.split()
        if len(fields) > 4 and re.sub(r'\\([0-7]{3})', lambda m: chr(int(m[1], 8)), fields[4]) == str(path):
            return True
    return False


def storage_bounded(function, timeout):
    """Bound NAS syscalls even when a worker is stuck in uninterruptible kernel I/O.

    Do not join a killed worker without a deadline. It may only exit on reconnect.
    A temporary result file also avoids a pipe filling up on a large directory.
    """
    with tempfile.TemporaryFile() as result:
        read_fd, write_fd = os.pipe()
        pid = os.fork()
        if pid == 0:
            os.close(read_fd)
            # In particular, do not retain the parent's flock in a stuck worker.
            keep = sorted({result.fileno(), write_fd})
            start = 3
            for fd in keep:
                os.closerange(start, fd)
                start = fd + 1
            os.closerange(start, os.sysconf('SC_OPEN_MAX'))
            try:
                try:
                    payload = {'result': function()}
                except Exception as error:
                    payload = {'error': str(error) if isinstance(error, ValueError) else storage_error(error)}
                result.write(json.dumps(payload).encode())
                result.flush()
                os.write(write_fd, b'1')
            finally:
                os._exit(0)
        os.close(write_fd)
        try:
            if not io_select.select([read_fd], [], [], timeout)[0] or not os.read(read_fd, 1):
                raise TimeoutError('网络存储操作超时')
            result.seek(0)
            payload = json.load(result)
            if 'error' in payload:
                raise ValueError(payload['error'])
            return payload['result']
        finally:
            os.close(read_fd)
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            os.waitpid(pid, os.WNOHANG)


def storage_capacity(path):
    info = os.statvfs(path)
    return {'totalBytes': info.f_blocks * info.f_frsize, 'freeBytes': info.f_bavail * info.f_frsize}


def storage_probe(path):
    if not storage_mounted(path):
        raise ValueError('网络存储尚未挂载')
    capacity = storage_capacity(path)
    user = pwd.getpwnam('khadas')
    os.initgroups('khadas', user.pw_gid)
    os.setgid(user.pw_gid)
    os.setuid(user.pw_uid)
    name = path / ('.vim4-write-test-' + secrets.token_hex(12))
    capacity['writable'] = False
    created = False
    try:
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        created = True
        try:
            os.write(fd, b'vim4 NAS write test\n')
        finally:
            os.close(fd)
        capacity['writable'] = True
    except PermissionError:
        pass
    finally:
        if created:
            name.unlink()
    return capacity


def storage_busy(path):
    session = nasdisk_read('session.json')
    if session and NAS_ROOT / session.get('storage', '') == path and nasdisk_active():
        return True
    prefix = str(path) + '/'
    def inside(value):
        return value == str(path) or value.startswith(prefix)
    for lun in Path('/sys/kernel/config/usb_gadget').glob('*/functions/mass_storage.*/lun.*/file'):
        if inside(lun.read_text().strip()):
            return True
    for process in Path('/proc').glob('[0-9]*'):
        for link in [process / 'cwd', process / 'root', *process.glob('fd/*')]:
            try:
                if inside(os.readlink(link)):
                    return True
            except OSError:
                pass
        try:
            if any(inside(line.split(None, 5)[5]) for line in (process / 'maps').read_text().splitlines()
                   if len(line.split(None, 5)) == 6):
                return True
        except OSError:
            pass
    return False


def storage_status(config):
    path = NAS_ROOT / config['id']
    mounted = storage_mounted(path)
    properties = storage_run(['systemctl', 'show', storage_unit_name(config['id']),
                              '--property=ActiveState,Result'], 2)
    properties = dict(line.split('=', 1) for line in properties.splitlines() if '=' in line)
    active, result = properties.get('ActiveState'), properties.get('Result', '')
    state = 'mounted' if mounted else ('mounting' if active == 'activating' else
                                      'error' if active == 'failed' else 'unmounted')
    data = dict(config, path=str(path), mounted=mounted, state=state,
                error='' if result in ('', 'success') else
                ('连接超时，NAS 无响应' if result == 'timeout' else '连接失败，请在编辑中「测试连接」查看原因'),
                totalBytes=None, freeBytes=None, stale=False, writable=None, busy=False,
                insecure=config['type'] == 'smb' and config['version'] == '1.0')
    try:
        data['writable'] = json.loads((NAS_RUNTIME / (config['id'] + '.json')).read_text())['writable']
    except (OSError, ValueError, KeyError):
        pass
    if mounted:
        try:
            data.update(storage_bounded(lambda: storage_capacity(path), 2))
        except (TimeoutError, ValueError):
            data['stale'] = True
        try:
            data['busy'] = storage_bounded(lambda: storage_busy(path), 1)
        except (TimeoutError, ValueError):
            data['busy'] = None
    return data


def storage_detect_write(config):
    value = None
    try:
        value = storage_bounded(lambda: storage_probe(NAS_ROOT / config['id']), 2)['writable']
    except (TimeoutError, ValueError):
        pass
    storage_atomic(NAS_RUNTIME / (config['id'] + '.json'), json.dumps({'writable': value}), 0o644)


def storage_unmount(config):
    path = NAS_ROOT / config['id']
    try:
        if storage_bounded(lambda: storage_busy(path), 2):
            raise ValueError('挂载点正被进程或 USB 虚拟介质使用，请先停止使用并弹出介质')
    except TimeoutError:
        raise ValueError('无法确认挂载点是否空闲，请稍后重试') from None
    storage_run(['systemctl', 'stop', storage_unit_name(config['id'])])
    if storage_mounted(path):
        raise ValueError('挂载点仍在使用，卸载失败')


def storage_save(request):
    config = storage_validate(request)
    existing = None
    if config['id']:
        existing = storage_load(config['id'])
        if existing['type'] != config['type']:
            raise ValueError('已有网络存储不能更改 ID 或类型')
    else:
        if len(list(NAS_CONFIG.glob('*.json'))) >= 8:
            raise ValueError('最多添加 8 个网络存储')
        base = re.sub('[^a-z0-9-]+', '-', config['name'].lower()).strip('-')[:23] or 'nas'
        config['id'] = base + '-' + secrets.token_hex(4)
        while (NAS_CONFIG / (config['id'] + '.json')).exists():
            config['id'] = base + '-' + secrets.token_hex(4)
    credentials = storage_credentials(config, request)
    path = NAS_ROOT / config['id']
    mounted = storage_mounted(path)
    if existing:
        # Stop pending jobs too, before replacing options used by systemd.
        storage_unmount(existing)
    NAS_CONFIG.mkdir(parents=True, exist_ok=True, mode=0o755)
    NAS_ROOT.mkdir(parents=True, exist_ok=True, mode=0o755)
    NAS_CONFIG.chmod(0o755)
    NAS_ROOT.chmod(0o755)
    path.mkdir(exist_ok=True, mode=0o755)
    if credentials is not None:
        storage_atomic(NAS_CONFIG / (config['id'] + '.cred'), credentials, 0o600)
    storage_atomic(NAS_CONFIG / (config['id'] + '.json'), json.dumps(config), 0o644)
    unit = storage_unit_name(config['id'])
    storage_atomic(NAS_UNITS / unit, storage_unit(config), 0o644)
    storage_run(['systemctl', 'daemon-reload'])
    storage_run(['systemctl', 'enable' if config['autoMount'] else 'disable', unit])
    (NAS_RUNTIME / (config['id'] + '.json')).unlink(missing_ok=True)
    if mounted or config['autoMount']:
        storage_run(['systemctl', 'start', unit])
        storage_detect_write(config)
    return storage_status(config)


def storage_test(request):
    started = time.monotonic()
    config = storage_validate(request, testing=True)
    if config['id']:
        existing = storage_load(config['id'])
        if existing['type'] != config['type']:
            raise ValueError('已有网络存储不能更改类型')
    credentials = storage_credentials(config, request)
    NAS_TEST.mkdir(parents=True, exist_ok=True, mode=0o755)
    NAS_TEST.chmod(0o755)
    temporary = Path(tempfile.mkdtemp(dir=NAS_TEST))
    # khadas must be able to traverse the temporary parent for the write probe.
    temporary.chmod(0o711)
    path, cred = temporary / 'mount', temporary / 'credentials'
    path.mkdir()
    answer = dict(ok=False, totalBytes=None, freeBytes=None, writable=None, elapsedMs=0, error='')
    try:
        if credentials is not None:
            storage_atomic(cred, credentials, 0o600)
        storage_run(['mount', '-t', 'cifs' if config['type'] == 'smb' else 'nfs',
                     '-o', storage_options(config, cred, unit=False), storage_source(config), str(path)], 8)
        answer.update(storage_bounded(lambda: storage_probe(path), 3))
        answer['ok'] = True
        if not answer['writable']:
            answer['error'] = 'khadas 权限被拒：共享不可写'
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        answer['error'] = str(error) if isinstance(error, ValueError) else storage_error(error)
    finally:
        try:
            if storage_mounted(path):
                storage_run(['umount', str(path)], 3)
            path.rmdir()
        except (OSError, ValueError) as error:
            answer.update(ok=False, error='测试挂载清理失败：' + storage_error(error))
        # Never recursively remove the temporary directory: it may still be a NAS mount.
        cred.unlink(missing_ok=True)
        try:
            temporary.rmdir()
        except OSError:
            pass
    if config['id']:
        storage_atomic(NAS_RUNTIME / (config['id'] + '.json'),
                       json.dumps({'writable': answer['writable']}), 0o644)
    answer['elapsedMs'] = round((time.monotonic() - started) * 1000)
    return answer


def storage_migrate():
    """Regenerate local units without letting a silent NAS delay startup."""
    deadline = time.monotonic() + 20
    messages = []
    for file in sorted(NAS_CONFIG.glob('*.json')):
        if time.monotonic() >= deadline:
            messages.append('storage-migrate: 总预算已用尽，剩余存储下次启动处理')
            break
        item_deadline = min(deadline, time.monotonic() + 5)
        def budget(limit):
            remaining = item_deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError('网络存储操作超时')
            return min(limit, remaining)
        try:
            config = storage_load(file.stem)
            unit = storage_run(['systemd-escape', '--path', '--suffix=mount', str(NAS_ROOT / config['id'])], budget(2))
            target, content = NAS_UNITS / unit, storage_unit(config)
            if target.exists() and target.read_text() == content:
                continue
            storage_atomic(target, content, 0o644)
            storage_run(['systemctl', 'daemon-reload'], budget(2))
            mount = NAS_ROOT / config['id']
            if storage_mounted(mount):
                if storage_bounded(lambda: storage_busy(mount), budget(1)):
                    messages.append(config['id'] + ': 存储忙，保留当前挂载，新参数下次启动生效')
                else:
                    storage_run(['systemctl', 'restart', unit], budget(3))
        except (ValueError, OSError) as error:
            messages.append(file.stem + ': ' + (str(error) if isinstance(error, ValueError) else storage_error(error)) + '，下次启动重试')
    return messages


def storage_path_parts(path, private=False):
    if not isinstance(path, str) or not path.startswith('/') or len(path) > 4096 or '\\' in path or any(ord(c) < 32 or ord(c) == 127 for c in path):
        raise ValueError('目录路径无效')
    parts = path[1:].split('/') if path != '/' else []
    if len(parts) > 32 or any(p in ('', '.', '..') or len(p.encode('utf-8')) > 255 or
                              private and p == '.vim4-nasdisk' for p in parts):
        raise ValueError('目录路径不能包含空段、. 或 ..')
    return parts


@contextmanager
def storage_open_directory(config, path, private=False):
    parts = storage_path_parts(path, private)
    root = NAS_ROOT / config['id']
    if not storage_mounted(root):
        raise ValueError('网络存储尚未挂载')
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts:
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        yield fd
    finally:
        os.close(fd)


def storage_mkdir(request):
    config = storage_load(request.get('id'))
    path, name = request.get('path'), request.get('name')
    storage_path_parts(path, private=True)
    if (not isinstance(name, str) or not name or name in ('.', '..', '.vim4-nasdisk') or
            name != name.strip() or len(name.encode('utf-8')) > 255 or
            re.search(r'[\x00-\x1f\x7f\\/"*?<>|:%]', name)):
        raise ValueError('文件夹名称包含不支持的字符或路径段')
    def create():
        with storage_open_directory(config, path, private=True) as fd:
            try:
                os.mkdir(name, mode=0o770, dir_fd=fd)
            except FileExistsError:
                raise ValueError('已有同名文件夹') from None
        return {'path': (path.rstrip('/') + '/' + name)}
    return storage_bounded(create, 3)


def storage_dirs(config, path):
    storage_path_parts(path)
    def listing():
        with storage_open_directory(config, path) as fd:
            entries = []
            with os.scandir(fd) as directory:
                for entry in directory:
                    if entry.is_dir(follow_symlinks=False):
                        entries.append(entry.name)
                        if len(entries) == 501:
                            break
            return {'path': path, 'entries': [{'name': name} for name in sorted(entries[:500])],
                    'truncated': len(entries) > 500}
    return storage_bounded(listing, 3)


def storage_command(argv):
    match argv:
        case ['storage-migrate']:
            return storage_migrate()
        case ['storage-mkdir']:
            return storage_mkdir(storage_read_request())
        case ['storage-list']:
            return {'known': True, 'tools': {'smb': bool(shutil.which('mount.cifs')),
                                            'nfs': bool(shutil.which('mount.nfs'))},
                    'storages': [storage_status(storage_load(p.stem)) for p in sorted(NAS_CONFIG.glob('*.json'))]}
        case ['storage-save']:
            return storage_save(storage_read_request())
        case ['storage-test']:
            return storage_test(storage_read_request())
        case ['storage-dirs', identifier, path]:
            return storage_dirs(storage_load(identifier), path)
        case ['storage-mount', identifier]:
            config = storage_load(identifier)
            storage_run(['systemctl', 'start', storage_unit_name(identifier)])
            storage_detect_write(config)
            return storage_status(config)
        case ['storage-unmount', identifier]:
            config = storage_load(identifier)
            storage_unmount(config)
            return storage_status(config)
        case ['storage-delete', identifier]:
            config = storage_load(identifier)
            if storage_read_request().get('confirm') != config['name']:
                raise ValueError('请确认完整的网络存储名称')
            storage_unmount(config)
            # Refuse misplaced local data before removing a recoverable unit/config.
            path = NAS_ROOT / identifier
            if path.exists():
                path.rmdir()
            unit = storage_unit_name(identifier)
            storage_run(['systemctl', 'disable', unit])
            (NAS_UNITS / unit).unlink(missing_ok=True)
            storage_run(['systemctl', 'daemon-reload'])
            for suffix in ('.json', '.cred'):
                (NAS_CONFIG / (identifier + suffix)).unlink(missing_ok=True)
            (NAS_RUNTIME / (identifier + '.json')).unlink(missing_ok=True)
            return {'ok': True}
        case _:
            raise ValueError('不支持的网络存储操作')


NASDISK_RUNTIME = Path('/run/vim4-nasdisk')


def nasdisk_read(name):
    try:
        return json.loads((NASDISK_RUNTIME / name).read_text())
    except FileNotFoundError:
        return None


def nasdisk_session_id(value):
    if not isinstance(value, str) or not re.fullmatch(r'[a-f0-9]{32}', value):
        raise ValueError('会话 ID 无效')
    return value


def nasdisk_folder(config, path):
    parts = storage_path_parts(path, private=True)
    def validate():
        with storage_open_directory(config, path, private=True):
            return str((NAS_ROOT / config['id']).joinpath(*parts))
    return storage_bounded(validate, 3)


def nasdisk_pending(timeout=3):
    def scan():
        pending = []
        remaining = 100000
        for file in sorted(NAS_CONFIG.glob('*.json')):
            config = storage_load(file.stem)
            mount = NAS_ROOT / config['id']
            if not storage_mounted(mount):
                continue
            for directory, dirs, files in os.walk(mount, followlinks=False):
                remaining -= len(dirs) + len(files) + 1
                if remaining < 0:
                    raise ValueError('恢复扫描条目过多')
                dirs[:] = [d for d in dirs if not (Path(directory) / d).is_symlink()]
                if '.vim4-nasdisk' not in dirs:
                    continue
                dirs.remove('.vim4-nasdisk')
                private = Path(directory) / '.vim4-nasdisk'
                for session in private.iterdir():
                    if session.is_symlink() or not re.fullmatch(r'[a-f0-9]{32}', session.name) or not session.is_dir():
                        continue
                    if not (session / 'overlay').exists() and not (session / 'journal').exists():
                        continue
                    metadata = json.loads((session / 'snapshot.json').read_text())['Config']
                    index = session / 'overlay.index'
                    relative = str(Path(directory).relative_to(mount))
                    pending.append(dict(id=session.name, storage=config['id'], storageName=config['name'],
                                        path='/' if relative == '.' else '/' + relative,
                                        writtenBytes=max(0, (index.stat().st_size - 512) // 24 * 4096) if index.exists() else 0,
                                        startedAt=metadata['startedAt'], utcOffsetMinutes=metadata.get('utcOffsetMinutes', 0),
                                        journal=(session / 'journal').exists()))
        return pending
    return storage_bounded(scan, timeout)


def nasdisk_active(timeout=3):
    return storage_run(['systemctl', 'show', '--property=ActiveState', '--value', 'vim4-nasdisk.service'], timeout).strip() in ('active', 'activating', 'deactivating')


def nasdisk_cleanup_mount():
    mount = NASDISK_RUNTIME / 'fs'
    # Do not stat a stale FUSE mount: even the mountpoint lookup can block.
    for line in Path('/proc/self/mountinfo').read_text().splitlines():
        fields = line.split()
        if len(fields) < 10 or re.sub(r'\\([0-7]{3})', lambda m: chr(int(m[1], 8)), fields[4]) != str(mount):
            continue
        if ' - fuse.nasdisk ' not in line:
            raise ValueError('U 盘镜像目录被其他文件系统占用')
        minor = int(fields[2].split(':')[1])
        try:
            Path(f'/sys/fs/fuse/connections/{minor}/abort').write_text('1\n')
        except FileNotFoundError:
            pass  # The old daemon has already released the connection.
        storage_run(['umount', '-l', str(mount)], 3)


def nasdisk_trash(last, empty=False, timeout=3):
    config = storage_load(last.get('storage'))
    def visit():
        with ExitStack() as stack:
            fd = stack.enter_context(storage_open_directory(config, last.get('path'), private=True))
            try:
                for part in ('.vim4-nasdisk', 'trash'):
                    fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                    stack.callback(os.close, fd)
            except FileNotFoundError:
                return dict(bytes=0, files=0)
            device = os.fstat(fd).st_dev
            result = dict(bytes=0, files=0)
            remaining = 100000
            def walk(parent, depth):
                nonlocal remaining
                if depth > 64:
                    raise ValueError('回收目录层级过深')
                with os.scandir(parent) as entries:
                    for entry in entries:
                        remaining -= 1
                        if remaining < 0:
                            raise ValueError('回收目录条目过多')
                        info = os.stat(entry.name, dir_fd=parent, follow_symlinks=False)
                        if stat.S_ISDIR(info.st_mode):
                            child = os.open(entry.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
                            try:
                                if os.fstat(child).st_dev != device:
                                    raise ValueError('回收目录包含其他挂载')
                                walk(child, depth + 1)
                            finally:
                                os.close(child)
                            if empty:
                                os.rmdir(entry.name, dir_fd=parent)
                        else:
                            if stat.S_ISREG(info.st_mode):
                                result['bytes'] += info.st_size
                                result['files'] += 1
                            if empty:
                                os.unlink(entry.name, dir_fd=parent)
            walk(fd, 0)
            return dict(bytes=0, files=0) if empty else result
    return storage_bounded(visit, timeout)


def nasdisk_trash_empty(request):
    identifier = nasdisk_session_id(request.get('id'))
    last = nasdisk_read('last.json')
    if not last or last.get('id') != identifier:
        raise ValueError('最后会话已改变')
    if request.get('confirm') != identifier:
        raise ValueError('请确认完整会话 ID')
    if nasdisk_active():
        raise ValueError('已有运行中的 NAS U 盘会话')
    last['trash'] = nasdisk_trash(last, empty=True)
    storage_atomic(NASDISK_RUNTIME / 'last.json', json.dumps(last), 0o600)
    return dict(ok=True, trash=last['trash'])


def nasdisk_control(action, identifier='', force=False, confirm=''):
    import socket
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(5)
        connection.connect(str(NASDISK_RUNTIME / 'control.sock'))
        connection.sendall((json.dumps(dict(action=action, id=identifier, force=force, confirm=confirm)) + '\n').encode())
        with connection.makefile('rb') as stream:
            result = json.loads(stream.readline(1024 * 1024))
    if result.get('error'):
        raise ValueError(result['error'])
    return result


def nasdisk_command(argv):
    match argv:
        case ['nasdisk-status']:
            # All probes share one budget; independent 3 s limits would add
            # up when pending and trash both hit the same frozen NAS.
            deadline = time.monotonic() + 2.7
            def remaining():
                budget = deadline - time.monotonic()
                if budget <= 0:
                    raise TimeoutError('网络存储状态查询超时')
                return budget
            session = nasdisk_read('status.json')
            last = nasdisk_read('last.json')
            known = True
            try:
                if not nasdisk_active(timeout=min(0.5, remaining())):
                    session = None
            except (ValueError, OSError):
                known = False
            try:
                pending = nasdisk_pending(timeout=remaining())
            except (ValueError, OSError):
                pending, known = [], False
            if session:
                pending = [item for item in pending if item['id'] != session['id']]
            if last:
                try:
                    last['trash'] = nasdisk_trash(last, timeout=remaining())
                except (ValueError, OSError):
                    last['trash'] = None
            return dict(known=known, session=session, last=last, pending=pending)
        case ['nasdisk-trash-empty']:
            return nasdisk_trash_empty(storage_read_request())
        case ['nasdisk-start']:
            request = storage_read_request()
            utc_offset = request.get('utcOffsetMinutes', time.localtime().tm_gmtoff // 60)
            if type(utc_offset) is not int or not -720 <= utc_offset <= 840:
                raise ValueError('时区偏移必须是 -720 到 840 之间的整数分钟')
            config = storage_load(request.get('storage'))
            root = nasdisk_folder(config, request.get('path', '/'))
            mode = request.get('mode')
            if mode not in ('ro', 'rw'):
                raise ValueError('请选择只读或可写模式')
            label = request.get('label', '')
            if not isinstance(label, str):
                raise ValueError('卷标无效')
            label = label.strip()
            if label and not re.fullmatch(r'[A-Z0-9 _-]{1,11}', label):
                raise ValueError('卷标最多 11 个大写字母数字空格下划线连字符')
            if not label:
                label = re.sub('[^A-Z0-9 _-]', '', Path(root).name.upper())[:11].strip() or 'NAS'
            with media_locks():
                if nasdisk_active():
                    raise ValueError('已有运行中的 NAS U 盘会话')
                if PIKVM_LUN_FILE.exists() and PIKVM_LUN_FILE.read_text().strip():
                    raise ValueError('已有虚拟磁盘挂载，请先安全弹出')
                nasdisk_cleanup_mount()
                import uuid
                session = dict(id=uuid.uuid4().hex, storage=config['id'], storageName=config['name'],
                               path=request.get('path', '/'), mode=mode, label=label, root=root, startedAt=int(time.time()),
                               utcOffsetMinutes=utc_offset)
                storage_atomic(NASDISK_RUNTIME / 'session.json', json.dumps(session), 0o600)
                (NASDISK_RUNTIME / 'control.sock').unlink(missing_ok=True)
                (NASDISK_RUNTIME / 'status.json').unlink(missing_ok=True)
                storage_run(['systemctl', 'start', 'vim4-nasdisk.service'], 5)
            return dict(ok=True, id=session['id'])
        case ['nasdisk-lun-attach', identifier]:
            if os.environ.get('SUDO_UID', '0') != '0':
                raise ValueError('此操作仅供 NAS U 盘守护进程调用')
            nasdisk_session_id(identifier)
            session = nasdisk_read('session.json')
            if not session or session['id'] != identifier or not nasdisk_active():
                raise ValueError('会话已改变')
            with media_locks():
                if PIKVM_LUN_FILE.read_text().strip():
                    raise ValueError('已有虚拟磁盘挂载，请先安全弹出')
                active = [app for app, unit in APPS.items() if storage_run(['systemctl', 'show', '--property=ActiveState', '--value', unit], 3).strip() == 'active']
                if len(active) != 1:
                    raise ValueError('请选择正在运行的 KVM')
                app = active[0]
                media_active(app)
                if app == 'jetkvm' and session['mode'] != 'ro':
                    raise ValueError('JetKVM 仅支持只读介质')
                fd = os.open(NASDISK_RUNTIME / 'fs' / ('disk-' + identifier + '.img'),
                             (os.O_RDONLY if session['mode'] == 'ro' else os.O_RDWR) | os.O_NOFOLLOW)
                try:
                    if not stat.S_ISREG(os.fstat(fd).st_mode):
                        raise ValueError('FUSE 镜像不是普通文件')
                    attach_media(fd, app, False, session['mode'] == 'ro')
                finally:
                    os.close(fd)
            return dict(ok=True)
        case ['nasdisk-cancel']:
            return nasdisk_control('cancel')
        case ['nasdisk-commit' | 'nasdisk-reattach' | 'nasdisk-discard', identifier, *options]:
            nasdisk_session_id(identifier)
            action = argv[0].removeprefix('nasdisk-')
            if options and (action != 'commit' or options != ['force']):
                raise ValueError('操作参数无效')
            confirm = storage_read_request().get('confirm', '') if action == 'discard' else ''
            if action == 'discard' and confirm != identifier:
                raise ValueError('请确认完整会话 ID')
            if nasdisk_active():
                return nasdisk_control(action, identifier, bool(options), confirm)
            if action == 'reattach':
                raise ValueError('恢复会话只能回写或放弃')
            pending = [item for item in nasdisk_pending() if item['id'] == identifier]
            if len(pending) != 1:
                raise ValueError('未找到唯一的待恢复会话')
            item = pending[0]
            config = storage_load(item['storage'])
            root = nasdisk_folder(config, item['path'])
            saved = json.loads((Path(root) / '.vim4-nasdisk' / identifier / 'snapshot.json').read_text())['Config']
            saved.update(id=identifier, storage=config['id'], storageName=config['name'], root=root,
                         path=item['path'], mode='rw', recover=action, force=bool(options))
            with media_locks():
                if PIKVM_LUN_FILE.exists() and PIKVM_LUN_FILE.read_text().strip():
                    raise ValueError('已有虚拟磁盘挂载，请先安全弹出')
                nasdisk_cleanup_mount()
                storage_atomic(NASDISK_RUNTIME / 'session.json', json.dumps(saved), 0o600)
                (NASDISK_RUNTIME / 'control.sock').unlink(missing_ok=True)
                storage_run(['systemctl', 'start', 'vim4-nasdisk.service'], 5)
            return dict(ok=True)
        case _:
            raise ValueError('不支持的 NAS U 盘操作')


def main(argv):
    if argv == ['storage-migrate']:
        for message in storage_migrate():
            print(message)
        return
    if argv and argv[0].startswith('nasdisk-'):
        print(json.dumps(nasdisk_command(argv)))
        return
    if argv and argv[0].startswith('storage-'):
        print(json.dumps(storage_command(argv)))
        return
    if argv and argv[0].startswith('wifi-'):
        print(json.dumps(wifi_command(argv)))
        return
    if argv and argv[0].startswith('tailscale-'):
        print(json.dumps(tailscale_command(argv)))
        return
    if argv and argv[0].startswith('disk-'):
        result = disk_command(argv)
        if argv[0] not in ('disk-get', 'disk-image'):
            print(json.dumps(result))
        return
    match argv:
        case ['cpu-power-snapshot']:
            print(json.dumps(cpu_power_snapshot()))
        case ['power-status']:
            print(json.dumps(power_status()))
        case ['mainline-hardware']:
            if not platform.release().startswith('7.'):
                raise ValueError('Mainline metadata is only available on the 7.x kernel')
            import vim4video
            print(json.dumps(vim4video.status()))
        case ['media-list']:
            print(json.dumps(media_catalog()))
        case ['media-mount', app, identifier, cdrom, readonly] if cdrom in ('true', 'false') and readonly in ('true', 'false'):
            media_mount(app, identifier, cdrom == 'true', readonly == 'true')
        case ['media-eject', expected]:
            media_eject(expected)
        case ['media-status']:
            print(json.dumps(media_status()))
        case ['update', package, checksum, version]:
            update(package, checksum, version)
        case ['edid-status']:
            print(json.dumps(edid_status()))
        case ['kernel-status']:
            import vim4boot
            print(json.dumps(vim4boot.status()))
        case ['passthrough-status']:
            result = subprocess.run(['/usr/libexec/vim4-passthrough', 'status'],
                                    capture_output=True, text=True, timeout=10)
            if result.returncode:
                raise ValueError(result.stderr.strip() or '透传状态读取失败')
            print(result.stdout.strip())
        case ['passthrough-set', enabled, audio, hdr] if all(value in ('true', 'false') for value in (enabled, audio, hdr)):
            result = subprocess.run(['/usr/libexec/vim4-passthrough', 'set', enabled, audio, hdr],
                                    capture_output=True, text=True, timeout=10)
            if result.returncode:
                raise ValueError(result.stderr.strip() or '透传设置失败')
            print(result.stdout.strip())
        case ['kernel-select', identifier, reboot] if reboot in ('true', 'false'):
            import vim4boot
            check_pikvm_media(entering=True)
            running = [unit for unit in APPS.values()
                       if subprocess.run(['systemctl', 'is-active', '--quiet', unit], timeout=10).returncode == 0]
            try:
                if reboot == 'true' and running:
                    systemctl('stop', *running)
                # A media request already in flight must not race the reboot.
                check_pikvm_media(entering=True)
                vim4boot.select(identifier)
                if reboot == 'true':
                    subprocess.run(['systemd-run', '--unit=vim4-kernel-reboot', '--on-active=3s',
                                    '/usr/bin/systemctl', 'reboot'], check=True, timeout=10)
            except Exception:
                if reboot == 'true' and running:
                    systemctl('start', *running)
                raise
        case ['edid-select', preset]:
            select_edid(preset)
        case ['select', app] if app in APPS:
            select(app)
        case ['restart', unit]:
            restart(unit)
        case ['wifi', enabled] if enabled in ('on', 'off'):
            wifi(enabled)
        case ['hdr-curve', white, peak]:
            hdr_curve(white, peak)
        case ['hdr-preview', white, peak]:
            apply_hdr_curve(white, peak)
        case ['fan-curve', low, mid, high]:
            fan_curve(low, mid, high)
        case ['fan-restore']:
            fan_restore()
        case _:
            raise ValueError('usage: vim4-manager-helper select nanokvm|jetkvm|onekvm|pikvm | restart UNIT | '
                             'hdr-curve|hdr-preview WHITE PEAK | fan-curve LOW MID HIGH | fan-restore | '
                             'wifi on|off | media-status | media-list | media-mount APP IMAGE CDROM READONLY | '
                             'media-eject TOKEN | edid-status | edid-select ID | update PACKAGE SHA256 VERSION | '
                             'tailscale-status|tailscale-install|tailscale-uninstall|tailscale-up|tailscale-down|'
                             'tailscale-logout | tailscale-login URL [PREVIOUS_URL] | tailscale-ping IP')


@contextmanager
def operation_lock(argv):
    action = argv[0] if argv else ''
    if action.startswith('disk-') or action in ('nasdisk-status', 'nasdisk-lun-attach', 'storage-list', 'storage-dirs', 'media-list', 'media-status', 'tailscale-status', 'tailscale-ping',
                                               'wifi-status', 'wifi-scan', 'power-status', 'cpu-power-snapshot', 'mainline-hardware', 'kernel-status', 'passthrough-status'):
        yield
        return
    path = '/run/lock/vim4-manager-tailscale.lock' if action.startswith('tailscale-') else '/run/lock/vim4-manager.lock'
    if action.startswith('storage-'):
        path = '/run/lock/vim4-manager-storage.lock'
    if action.startswith('nasdisk-'):
        path = '/run/lock/vim4-manager-storage.lock'
    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        # The package worker may start before the launching helper releases its
        # Tailscale lock. Other writers still fail immediately.
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if action == 'tailscale-package' else fcntl.LOCK_NB))
        if action in ('update', 'tailscale-package'):
            package_fd = os.open('/run/lock/vim4-manager-packages.lock',
                                 os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            try:
                # Fail before touching APT rather than spending the worker's
                # runtime budget waiting and then interrupting a transaction.
                fcntl.flock(package_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                yield
            finally:
                os.close(package_fd)
        else:
            yield
    finally:
        os.close(fd)


def interrupted(signum, frame):
    # Unwind allocation/staging cleanup when the HTTP streaming runner cancels.
    raise InterruptedError('操作已取消')


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, interrupted)
    try:
        with operation_lock(sys.argv[1:]):
            main(sys.argv[1:])
    except BlockingIOError:
        action = sys.argv[1] if len(sys.argv) > 1 else ''
        busy = ('Another package operation is in progress' if action in ('update', 'tailscale-package') else
                '另一个 NAS U 盘操作正在进行，请稍后重试' if action.startswith('nasdisk-') else
                '另一个网络存储操作正在进行，请稍后重试' if action.startswith('storage-') else
                '另一个数据盘操作正在进行，请稍后重试' if action.startswith('disk-') else
                'Another tailscale operation is in progress' if action.startswith('tailscale-') else
                'Another switch is in progress')
        if action == 'tailscale-package':
            tailscale_write_job(sys.argv[2], False, busy)
        print(busy, file=sys.stderr)
        sys.exit(75)
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        if len(sys.argv) > 2 and sys.argv[1] == 'tailscale-package':
            tailscale_write_job(sys.argv[2], False, str(error))
        print(error, file=sys.stderr)
        sys.exit(1)
