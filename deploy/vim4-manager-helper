#!/usr/bin/python3
"""Root operations for vim4-manager. Only fixed actions are accepted."""
import fcntl
import os
import subprocess
import sys

# Keep in sync with internal/board/units.go. The units declare Conflicts= with
# each other: starting one stops the other, so they never share the encoder.
APPS = {'nanokvm': 'nanokvm.service', 'jetkvm': 'vim4-kvm.service'}
# Gadget rebinds and PD renegotiation can drop the host USB link; those stay
# with the board tools.
PLATFORM = ('vim4-kvm-hdmi.service',)
HDMI = 'vim4-kvm-hdmi.service'
# HDR -> SDR curve read by hdmi-setup.sh. Separate from vim4-kvm-hdmi because
# NanoKVM rewrites that file. Limits match hdmi-setup.sh.
HDR_CONFIG = '/etc/default/vim4-kvm-hdr'


def systemctl(*args):
    subprocess.run(['systemctl', *args], check=True, timeout=60, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})


def installed(unit):
    result = subprocess.run(['systemctl', 'show', '--property=LoadState', '--value', unit],
                            capture_output=True, text=True, timeout=10, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})
    return result.stdout.strip() == 'loaded'


def select(app):
    unit = APPS[app]
    if not installed(unit):
        raise ValueError(f'{unit} is not installed')
    others = [other for other in APPS.values() if other != unit and installed(other)]
    # Disable first: an interrupted switch must not boot with both enabled.
    if others:
        systemctl('disable', *others)
    systemctl('enable', unit)
    # Conflicts= does not order shutdown before startup. Wait until the old
    # process has released port 8080, HID and the encoder before starting.
    if others:
        systemctl('stop', *others)
    systemctl('restart', unit)
    # Enablement links must survive the data=writeback root filesystem.
    os.sync()


def restart(unit):
    if unit not in (*APPS.values(), *PLATFORM):
        raise ValueError('Unit is not managed')
    if unit in APPS.values():
        others = [other for other in APPS.values() if other != unit and installed(other)]
        if others:
            systemctl('stop', *others)
        systemctl('restart', unit)
        return
    restart_hdmi()


def restart_hdmi(rollback=None):
    """Restart HDMI capture with the running application paused.

    The HDMI service reconfigures capture underneath a running encoder; stop
    the active application first, then start it again on the new capture.
    """
    active = [app for app in APPS.values() if installed(app) and
              subprocess.run(['systemctl', 'is-active', '--quiet', app], timeout=10).returncode == 0]
    if active:
        systemctl('stop', *active)
    try:
        systemctl('restart', HDMI)
    except subprocess.SubprocessError:
        if rollback is None:
            raise
        # Bring capture back on the previous settings before reporting.
        rollback()
        systemctl('reset-failed', HDMI)
        systemctl('restart', HDMI)
        raise
    finally:
        if active:
            systemctl('start', *active)


def nits(text, low, high):
    if not (text.isascii() and text.isdigit()) or not low <= int(text) <= high:
        raise ValueError(f'{text!r} must be {low}-{high} nits')
    return int(text)


def read_config(path):
    try:
        with open(path, 'rb') as file:
            return file.read()
    except FileNotFoundError:
        return None


def write_config(path, content):
    if content is None:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    else:
        pending = path + '.pending'
        with open(pending, 'wb') as file:
            file.write(content)
            os.fchmod(file.fileno(), 0o644)
            os.fsync(file.fileno())
        os.replace(pending, path)
    os.sync()


def hdr_curve(white, peak):
    """Write HDR_SDR_WHITE/HDR_SDR_PEAK and restart capture; restore on failure."""
    white = nits(white, 80, 1000)
    peak = nits(peak, white + 1, 10000)
    previous = read_config(HDR_CONFIG)
    write_config(HDR_CONFIG, f'HDR_SDR_WHITE={white}\nHDR_SDR_PEAK={peak}\n'.encode())
    restart_hdmi(rollback=lambda: write_config(HDR_CONFIG, previous))


def main(argv):
    match argv:
        case ['select', app] if app in APPS:
            select(app)
        case ['restart', unit]:
            restart(unit)
        case ['hdr-curve', white, peak]:
            hdr_curve(white, peak)
        case _:
            raise ValueError('usage: vim4-manager-helper select nanokvm|jetkvm | restart UNIT | hdr-curve WHITE PEAK')


if __name__ == '__main__':
    try:
        lock = os.open('/run/lock/vim4-manager.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        main(sys.argv[1:])
    except BlockingIOError:
        print('Another switch is in progress', file=sys.stderr)
        sys.exit(75)
    except (ValueError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
